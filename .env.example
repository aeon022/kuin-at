# Base URL of the Orbiter admin server (@a83/orbiter-admin) — its public,
# unauthenticated POST /api/form/:formId endpoint is what the Kontakt- and
# Newsletter-Formular submit to. In production this is the api.kuin.at
# vhost proxying to the orbiter-admin process on the Plesk box; in dev it's
# the local admin server started with `npm run admin` (port 4322).
PUBLIC_ORBITER_ADMIN_URL=http://localhost:4322
