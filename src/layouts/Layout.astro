---
// Layout.astro — head/body chrome 1:1 from mockup.html, replacing the old
// BaseLayout.astro. Two additions beyond the mockup, both required because
// this layout serves the whole multi-page site instead of one static file:
// per-page title/description (Props) instead of a fixed <title>, and
// server-rendered `data-ll` / `.is-leicht-lesen` from the LL cookie so
// there's no flash of Standard content before Header.astro's script runs
// (same anti-flash approach the site already used pre-conversion).
import '../styles/global.css';
import Header from '../components/Header.astro';
import CommandPalette from '../components/CommandPalette.astro';
import Footer from '../components/Footer.astro';
import CookieNotice from '../components/CookieNotice.astro';
import { getMediaItem } from 'orbiter:media';
import { ClientRouter } from 'astro:transitions';

interface Props { title: string; description?: string; active?: string; image?: string }
const {
  title,
  description = 'Kultur Inklusiv Graz — Kunst und Kultur barrierefrei erleben.',
  active,
  // public/og-image.png: brand-gradient card with the (white/inverted)
  // wordmark, generated from the same CMS logo — swap per-page via the
  // `image` prop for pages that want their own (an event flyer, etc.).
  image,
} = Astro.props;

const logo = await getMediaItem('05702c2b-c0ca-47d7-aef4-72e285f169cb');
const ogImage = new URL(image ?? '/og-image.png', Astro.site ?? Astro.url).toString();
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();

const leichtLesenActive = Astro.cookies.get('kuin-leicht-lesen')?.value === 'true';
const fontSizeStep = Astro.cookies.get('kuin-font-size')?.value;
const contrastActive = Astro.cookies.get('kuin-contrast')?.value === 'true';
const reduceMotionActive = Astro.cookies.get('kuin-reduce-motion')?.value === 'true';
const themeCookie = Astro.cookies.get('kuin-theme')?.value;
// 'system' is never rendered as an attribute — its whole point is "let the
// prefers-color-scheme media query decide", same as no cookie at all.
const themeAttr = themeCookie === 'light' || themeCookie === 'dark' ? themeCookie : undefined;
---
<!doctype html>
<html
  lang="de"
  class="scroll-smooth"
  data-ll={leichtLesenActive ? 'true' : undefined}
  data-font-size={fontSizeStep === '1' || fontSizeStep === '2' ? fontSizeStep : undefined}
  data-contrast={contrastActive ? 'true' : undefined}
  data-reduce-motion={reduceMotionActive ? 'true' : undefined}
  data-theme={themeAttr}
>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} · KUIN</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <meta name="robots" content="index, follow" />

  <!-- SVG primary (crisp at any size, modern browsers): the CMS wordmark
       directly. /favicon.ico and /apple-touch-icon.png are pre-cropped
       square PNGs (public/, generated from the same source logo) for
       browsers/contexts that need a literal square — iOS home-screen
       icons especially don't letterbox a non-square source the way an
       SVG favicon does. -->
  {logo && <link rel="icon" type="image/svg+xml" href={logo.url} />}
  <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="48x48" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <!-- Open Graph / Twitter — og:url and canonical both resolve against
       `site` (astro.config.mjs: the real kuin.at), so these stay correct
       even served from preview.kuin.at. -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="KUIN — Kultur Inklusiv" />
  <meta property="og:locale" content="de_AT" />
  <meta property="og:title" content={`${title} · KUIN`} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`${title} · KUIN`} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- Loaded non-render-blocking (PageSpeed flagged the plain <link
       rel="stylesheet"> version: ~1.8s of render-blocking time on
       mobile/slow-4G). `media="print"` makes the browser fetch it at low
       priority without blocking first paint; the `onload` swap to
       `media="all"` applies it the instant it's ready. `display=swap` in
       the URL already prevents invisible text either way, so nothing
       about the previous no-flash behaviour changes — this only removes
       the artificial wait before the page can paint anything at all.
       <noscript> covers the (rare) no-JS case. -->
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400;1,700&family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,500;0,700;0,800;1,500&display=swap"
    media="print"
    onload="this.media='all'"
  />
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400;1,700&family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,500;0,700;0,800;1,500&display=swap" />
  </noscript>

  <!-- Client-side page transitions between routes. IMPORTANT: every inline
       <script> sitewide had to move its init logic into an
       `astro:page-load` listener for this — a module script only ever
       executes once per browser session (module de-dup), so without that
       change every toggle/form/palette would go dead after the first
       client-side navigation. See each component's own script for the
       same note. fallback="swap": browsers without native View
       Transitions support (older Firefox) still get instant client-side
       nav, just without the animation, rather than degrading to a full
       page reload either way. -->
  <ClientRouter fallback="swap" />
</head>
<body class:list={['bg-washi text-sumi-900 font-sans antialiased min-h-screen selection:bg-kuin-magenta selection:text-washi overflow-x-hidden', { 'is-leicht-lesen': leichtLesenActive }]}>
  <a href="#main" class="sr-only rounded-lg shadow-2xl focus:not-sr-only focus:absolute focus:top-6 focus:left-6 focus:z-50 focus:bg-kuin-magenta focus:px-6 focus:py-3 focus:font-bold focus:text-washi">
    Zum Hauptinhalt springen
  </a>
  <Header active={active} />
  <slot />
  <Footer />
  <CommandPalette />
  <CookieNotice />
</body>
</html>
