---
// Layout.astro — head/body chrome 1:1 from mockup.html, replacing the old
// BaseLayout.astro. Two additions beyond the mockup, both required because
// this layout serves the whole multi-page site instead of one static file:
// per-page title/description (Props) instead of a fixed <title>, and
// server-rendered `data-ll` / `.is-leicht-lesen` from the LL cookie so
// there's no flash of Standard content before Header.astro's script runs
// (same anti-flash approach the site already used pre-conversion).
import '../styles/global.css';
import Header from '../components/Header.astro';
import CommandPalette from '../components/CommandPalette.astro';
import Footer from '../components/Footer.astro';
import CookieNotice from '../components/CookieNotice.astro';
import { getMediaItem } from 'orbiter:media';

interface Props { title: string; description?: string; active?: string; image?: string }
const {
  title,
  description = 'Kultur Inklusiv Graz — Kunst und Kultur barrierefrei erleben.',
  active,
  // No dedicated 1200×630 social-share image exists yet — the wordmark is
  // a sane, always-available default (on-brand, real content) rather than
  // shipping no og:image at all; swap per-page via the `image` prop once
  // one exists.
  image,
} = Astro.props;

const logo = await getMediaItem('05702c2b-c0ca-47d7-aef4-72e285f169cb');
const ogImage = new URL(image ?? logo?.url ?? '/favicon.svg', Astro.site ?? Astro.url).toString();
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();

const leichtLesenActive = Astro.cookies.get('kuin-leicht-lesen')?.value === 'true';
const fontSizeStep = Astro.cookies.get('kuin-font-size')?.value;
const contrastActive = Astro.cookies.get('kuin-contrast')?.value === 'true';
const reduceMotionActive = Astro.cookies.get('kuin-reduce-motion')?.value === 'true';
const themeCookie = Astro.cookies.get('kuin-theme')?.value;
// 'system' is never rendered as an attribute — its whole point is "let the
// prefers-color-scheme media query decide", same as no cookie at all.
const themeAttr = themeCookie === 'light' || themeCookie === 'dark' ? themeCookie : undefined;
---
<!doctype html>
<html
  lang="de"
  class="scroll-smooth"
  data-ll={leichtLesenActive ? 'true' : undefined}
  data-font-size={fontSizeStep === '1' || fontSizeStep === '2' ? fontSizeStep : undefined}
  data-contrast={contrastActive ? 'true' : undefined}
  data-reduce-motion={reduceMotionActive ? 'true' : undefined}
  data-theme={themeAttr}
>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} · KUIN</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <meta name="robots" content="index, follow" />

  {logo && <link rel="icon" type="image/svg+xml" href={logo.url} />}

  <!-- Open Graph / Twitter — og:url and canonical both resolve against
       `site` (astro.config.mjs: the real kuin.at), so these stay correct
       even served from preview.kuin.at. -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="KUIN — Kultur Inklusiv" />
  <meta property="og:locale" content="de_AT" />
  <meta property="og:title" content={`${title} · KUIN`} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`${title} · KUIN`} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400;1,700&family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,500;0,700;0,800;1,500&display=swap" rel="stylesheet" />
</head>
<body class:list={['bg-washi text-sumi-900 font-sans antialiased min-h-screen selection:bg-kuin-magenta selection:text-washi overflow-x-hidden', { 'is-leicht-lesen': leichtLesenActive }]}>
  <a href="#main" class="sr-only rounded-lg shadow-2xl focus:not-sr-only focus:absolute focus:top-6 focus:left-6 focus:z-50 focus:bg-kuin-magenta focus:px-6 focus:py-3 focus:font-bold focus:text-washi">
    Zum Hauptinhalt springen
  </a>
  <Header active={active} />
  <slot />
  <Footer />
  <CommandPalette />
  <CookieNotice />
</body>
</html>
