---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'orbiter:collections';
import { PersonSchema } from '../../schemas';
import { parseEntries } from '../../lib/content';
import PersonCard from '../../components/PersonCard.astro';
import PlaceholderPersonCard from '../../components/PlaceholderPersonCard.astro';

// Order as in the Vereinsregisterauszug; unknown roles go last (then by name).
const ROLE_ORDER = ['Obfrau', 'Obfrau-Stellvertreter', 'Kassierin', 'Kassierin-Stellvertreterin', 'Schriftführerin', 'Schriftführerin-Stellvertreter'];
const rank = (role: string) => { const i = ROLE_ORDER.indexOf(role); return i < 0 ? ROLE_ORDER.length : i; };
const board = parseEntries('people', await getCollection('people'), PersonSchema)
  .map((e) => e.data)
  .filter((p) => p.category === 'vorstand')
  .sort((a, b) => rank(a.role) - rank(b.role) || a.name.localeCompare(b.name, 'de'));
---
<Layout title="Vorstand" active="ueber-uns">
  <main id="main" class="mx-auto max-w-3xl px-4 py-16 md:py-24">
    <a href="/der-verein" class="inline-flex items-center gap-2 text-sm font-semibold text-sumi-600 transition-colors hover:text-kuin-magenta">
      ← Über uns
    </a>
    <h1 class="mt-4 mb-12 text-4xl font-bold text-sumi-900 md:text-5xl">Vorstand</h1>
    {board.length > 0 ? (
      <ul class="grid grid-cols-1 gap-8 sm:grid-cols-2">
        {board.map((person) => <PersonCard person={person} />)}
      </ul>
    ) : (
      <>
        <p class="mb-8 text-sumi-600"><em>Der Vorstand wird demnächst hier vorgestellt.</em></p>
        <ul class="grid grid-cols-1 gap-8 sm:grid-cols-2">
          <PlaceholderPersonCard />
          <PlaceholderPersonCard />
        </ul>
      </>
    )}
  </main>
</Layout>
