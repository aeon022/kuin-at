---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'orbiter:collections';
import { PersonSchema } from '../../schemas';
import { parseEntries } from '../../lib/content';
import PersonCard from '../../components/PersonCard.astro';
import PlaceholderPersonCard from '../../components/PlaceholderPersonCard.astro';

const team = parseEntries('people', await getCollection('people'), PersonSchema)
  .map((e) => e.data)
  .filter((p) => p.category === 'team');
---
<Layout title="Team" active="ueber-uns">
  <main id="main" class="mx-auto max-w-3xl px-4 py-16 md:py-24">
    <a href="/der-verein" class="inline-flex items-center gap-2 text-sm font-semibold text-sumi-600 transition-colors hover:text-kuin-magenta">
      ← Über uns
    </a>
    <h1 class="mt-4 mb-12 text-4xl font-bold text-sumi-900 md:text-5xl">Team</h1>
    {team.length > 0 ? (
      <ul class="grid grid-cols-1 gap-8 sm:grid-cols-2">
        {team.map((person) => <PersonCard person={person} />)}
      </ul>
    ) : (
      <>
        <p class="mb-8 text-sumi-600"><em>Unser Team wird demnächst hier vorgestellt.</em></p>
        <ul class="grid grid-cols-1 gap-8 sm:grid-cols-2">
          <PlaceholderPersonCard />
          <PlaceholderPersonCard />
          <PlaceholderPersonCard />
        </ul>
      </>
    )}
  </main>
</Layout>
