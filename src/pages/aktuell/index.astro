---
// Client request 2026-09: "Im Punkt Aktuell sollten dann 2 Kategorien sein:
// Veranstaltungen | Newsletter" — a small hub, not a third listing page.
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Aktuell" active="events">
  <main id="main" class="mx-auto max-w-3xl px-4 py-16 md:py-24">
    <h1 class="mb-12 text-4xl font-bold md:text-5xl">Aktuell</h1>

    <section class="mb-10">
      <h2 class="mb-2 text-xl font-semibold">
        <a href="/events" class="text-magenta-dark underline">Veranstaltungen</a>
      </h2>
      <p class="text-sumi-600">Alle kommenden Termine, Führungen und Spaziergänge von KUIN.</p>
    </section>

    <section>
      <h2 class="mb-2 text-xl font-semibold">
        <a href="/blog" class="text-magenta-dark underline">Newsletter</a>
      </h2>
      <p class="text-sumi-600">Unsere Newsletter mit Rückblicken und Neuigkeiten aus dem Verein.</p>
    </section>
  </main>
</Layout>
