---
// index.astro — Hero → EventCard (Nächster Walk) → ArchiveGallery →
// Manifest → Partner is 1:1 from mockup.html's <main>. MembershipCta is a
// new closing section (client draft, 2026-09), not part of the mockup.
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import EventCard from '../components/EventCard.astro';
import ArchiveGallery from '../components/ArchiveGallery.astro';
import Manifest from '../components/Manifest.astro';
import Partner from '../components/Partner.astro';
import Supporters from '../components/Supporters.astro';
import MembershipCta from '../components/MembershipCta.astro';
---
<Layout title="Home" active="home">
  <main id="main" class="breathing-element mx-auto max-w-6xl space-y-32 px-6 py-16 md:space-y-48 md:px-12 md:py-24">
    <Hero />
    <EventCard />
    <ArchiveGallery />
    <Manifest />
    <Partner />
    <Supporters />
    <MembershipCta />
  </main>
</Layout>
