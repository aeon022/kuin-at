---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'orbiter:collections';
import { getMediaItem } from 'orbiter:media';
import { PartnerSchema } from '../schemas';
import { parseEntries } from '../lib/content';

// Hero copy and logo come from the real WordPress homepage content
// (recovered from the "Netzwerk" section on the legacy Landing page,
// migrated via the Oxygen extractor) — not invented placeholder text.
const logo = await getMediaItem('05702c2b-c0ca-47d7-aef4-72e285f169cb');

// Pull-quote is a verbatim sentence from the real der-verein page content
// (Projektkonzept section) — not invented copy.
const quote = 'Kultur Inklusiv basiert auf der Überzeugung, dass Kultur durch die Begegnung und den Austausch von Menschen entsteht.';

const posts = (await getCollection('blog'))
  .filter((p) => p.data.published_at)
  .sort((a, b) => new Date(b.data.published_at).getTime() - new Date(a.data.published_at).getTime())
  .slice(0, 3);

const now = Date.now();
const events = (await getCollection('events'))
  .filter((e) => e.data.start_date && new Date(e.data.start_date).getTime() >= now)
  .sort((a, b) => new Date(a.data.start_date).getTime() - new Date(b.data.start_date).getTime())
  .slice(0, 3);

const partners = parseEntries('partners', await getCollection('partners'), PartnerSchema).map((e) => e.data);
const withLogos = await Promise.all(
  partners.map(async (p) => ({ ...p, logoMedia: await getMediaItem(p.logo) }))
);
const network = withLogos.filter((p) => p.logoMedia);
---
<BaseLayout title="Home" active="home">
  <!-- Hero: editorial, left-aligned, generous whitespace ("Ma") — reduced
       from an earlier, louder pass (was text-6xl/[5.5rem]). Logo sits
       below the copy as a closing signature rather than competing with
       the headline for weight at the top. -->
  <section class="mx-auto max-w-4xl px-4 pt-16 pb-14 md:pt-20 md:pb-20">
    <h1 class="text-4xl leading-[1.1] font-bold tracking-tight text-sumi-900 md:text-6xl">
      Kultur ohne <br />
      <span class="font-medium text-sumi-600 italic">Hindernisse.</span>
    </h1>
    <p class="mt-8 max-w-2xl text-lg leading-relaxed font-light text-sumi-600">
      Das Projekt „Kultur Inklusiv" hat das Ziel, kulturelle Teilhabe als universelles
      Menschenrecht zu fördern und Inklusion als selbstverständliches Element des
      kulturellen Lebens zu etablieren.
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <a href="/der-verein" class="rounded-2xl bg-magenta-dark px-6 py-3 font-medium text-washi transition hover:-translate-y-1 hover:bg-kuin-magenta">
        Über uns
      </a>
      <a href="/aktuell" class="rounded-2xl border border-sumi-900/15 px-6 py-3 font-medium text-sumi-900 transition hover:-translate-y-1 hover:bg-sumi-900/5">
        Aktuelles
      </a>
    </div>
    {logo && <img src={logo.url} alt={logo.alt ?? 'KUIN Logo'} class="mt-12 h-10 w-auto" />}
  </section>

  <main id="main" class="mx-auto max-w-5xl space-y-24 px-4 pb-24 md:space-y-32">
    <!-- Featured card: layered depth (a rotated shadow panel behind a
         glass-blur foreground), the actual most recent real content. -->
    {posts.length > 0 && (
      <section class="group relative">
        <div class="absolute inset-0 -z-10 rotate-1 rounded-[2.5rem] border border-sumi-900/5 bg-washi transition-transform duration-500 group-hover:rotate-2"></div>
        <div class="rounded-[2.5rem] border border-sumi-900/10 bg-white/60 p-8 backdrop-blur-sm md:p-12">
          <div class="ll-fade mb-8 inline-flex items-center gap-2 rounded-full bg-kuin-magenta/10 px-4 py-1.5 text-xs font-bold tracking-widest text-magenta-dark uppercase">
            <span class="h-1.5 w-1.5 rounded-full bg-kuin-magenta"></span>
            Aktuell
          </div>
          <div class="grid gap-8 md:grid-cols-2">
            {posts.map((post) => (
              <article>
                <h2 class="text-2xl font-bold text-sumi-900">
                  <a href={`/blog/${post.slug}`} class="hover:text-kuin-magenta">{post.data.title}</a>
                </h2>
                <time datetime={post.data.published_at} class="ll-fade mt-2 block text-sm font-semibold tracking-widest text-sumi-600 uppercase">
                  {new Date(post.data.published_at).toLocaleDateString('de-AT', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
              </article>
            ))}
          </div>
          <a href="/blog" class="mt-8 inline-flex items-center gap-2 font-semibold text-magenta-dark hover:text-kuin-magenta">
            Alle Beiträge <span class="transition-transform group-hover:translate-x-1">→</span>
          </a>
        </div>
      </section>
    )}

    <!-- Upcoming events as cards — a big display-serif date numeral is the
         real KUIN identity carried over from the old site's event flyers,
         not decoration. -->
    <section>
      <h2 class="mb-8 text-sm font-bold tracking-widest text-sumi-600 uppercase">Kommende Veranstaltungen</h2>
      {events.length > 0 ? (
        <ul class="grid gap-8 md:grid-cols-2">
          {events.map((event) => {
            const eventDate = new Date(event.data.start_date);
            return (
              <li class="rounded-[2.5rem] border border-sumi-900/10 bg-washi p-8 transition hover:-translate-y-1">
                <article class="flex items-start gap-6">
                  <div class="shrink-0">
                    <span class="block font-serif text-5xl font-bold tracking-tighter text-sumi-900">
                      {eventDate.getDate()}.
                    </span>
                    <span class="ll-fade mt-1 block text-xs font-semibold tracking-widest text-sumi-600 uppercase">
                      {eventDate.toLocaleDateString('de-AT', { month: 'long' })}
                    </span>
                  </div>
                  <div>
                    <h3 class="text-xl font-bold text-sumi-900">
                      <a href={`/events/${event.slug}`} class="hover:text-kuin-magenta">{event.data.title}</a>
                    </h3>
                    <p class="mt-2 text-sm text-sumi-600">{event.data.location}</p>
                  </div>
                </article>
              </li>
            );
          })}
        </ul>
      ) : (
        <div class="rounded-[2.5rem] border border-sumi-900/10 bg-washi p-8 text-center md:p-12">
          <p class="text-sumi-600"><em>Derzeit sind keine Veranstaltungen geplant.</em></p>
        </div>
      )}
    </section>

    <!-- Pull-quote — verbatim sentence from der-verein, styled at real
         editorial scale. -->
    <section class="mx-auto max-w-2xl">
      <blockquote class="border-l-4 border-kuin-magenta py-2 pl-8 font-serif text-3xl leading-snug text-sumi-900 italic">
        „{quote}"
      </blockquote>
    </section>

    {network.length > 0 && (
      <section class="border-t border-sumi-900/10 pt-16 text-center">
        <h2 class="mb-2 text-sm font-bold tracking-widest text-sumi-600 uppercase">Unser Netzwerk</h2>
        <ul class="mt-10 grid grid-cols-3 gap-x-8 gap-y-10 opacity-70 transition-opacity duration-500 hover:opacity-100 sm:grid-cols-5">
          {network.map((p) => (
            <li class="flex items-center justify-center">
              {p.website_url ? (
                <a href={p.website_url} rel="noopener" title={p.name} class="transition hover:-translate-y-1">
                  <img src={p.logoMedia?.url} alt={p.logoMedia?.alt ?? p.name} class="h-12 w-auto object-contain grayscale transition hover:grayscale-0" />
                </a>
              ) : (
                <img src={p.logoMedia?.url} alt={p.logoMedia?.alt ?? p.name} class="h-12 w-auto object-contain" />
              )}
            </li>
          ))}
        </ul>
        <p class="mt-10">
          <a href="/partner" class="font-semibold text-magenta-dark hover:text-kuin-magenta">Alle Partner ansehen →</a>
        </p>
      </section>
    )}
  </main>
</BaseLayout>
