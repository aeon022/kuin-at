---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'orbiter:collections';

const posts = (await getCollection('blog'))
  .filter((p) => p.data.published_at)
  .sort((a, b) => new Date(b.data.published_at).getTime() - new Date(a.data.published_at).getTime())
  .slice(0, 3);

const now = Date.now();
const events = (await getCollection('events'))
  .filter((e) => e.data.start_date && new Date(e.data.start_date).getTime() >= now)
  .sort((a, b) => new Date(a.data.start_date).getTime() - new Date(b.data.start_date).getTime())
  .slice(0, 3);
---
<BaseLayout title="Home" active="home">
  <main class="mx-auto max-w-3xl px-4 py-10">
    <h1 class="mb-8 text-3xl font-bold">KUIN — Kultur Inklusiv</h1>

    <section class="mb-10">
      <h2 class="mb-4 text-xl font-semibold">Aktuelle Beiträge</h2>
      {posts.length > 0 ? (
        <ul class="flex flex-col gap-2">
          {posts.map((post) => (
            <li><a href={`/blog/${post.slug}`} class="text-teal-700 underline">{post.data.title}</a></li>
          ))}
        </ul>
      ) : (
        <p class="text-slate-700"><em>Derzeit keine Beiträge.</em></p>
      )}
    </section>

    <section>
      <h2 class="mb-4 text-xl font-semibold">Kommende Veranstaltungen</h2>
      {events.length > 0 ? (
        <ul class="flex flex-col gap-2">
          {events.map((event) => (
            <li><a href={`/events/${event.slug}`} class="text-teal-700 underline">{event.data.title}</a></li>
          ))}
        </ul>
      ) : (
        <p class="text-slate-700"><em>Derzeit sind keine Veranstaltungen geplant.</em></p>
      )}
    </section>
  </main>
</BaseLayout>
