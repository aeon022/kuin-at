---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'orbiter:collections';
import ProseSwap from '../../components/ProseSwap.astro';

const events = (await getCollection('events'))
  .filter((e) => e.data.start_date)
  .sort((a, b) => new Date(a.data.start_date).getTime() - new Date(b.data.start_date).getTime());
---
<Layout title="Veranstaltungen" active="events">
  <main id="main" class="mx-auto max-w-3xl px-4 py-16 md:py-24">
    <h1 class="mb-4 text-4xl font-bold md:text-5xl">Veranstaltungen</h1>
    <ProseSwap
      class="mb-12 max-w-2xl text-lg text-sumi-600"
      standard="<p>Zwei Mal im Jahr organisiert Kultur Inklusiv den „Walk“. Dieser Rundgang ist als inklusiver kultureller Spaziergang durch die Stadt gestaltet. Er umfasst mehrere Ausstellungen und Veranstaltungen. Wir erforschen gemeinsam den Stadtraum und machen kulturelle Barrierefreiheit aktiv erlebbar.</p>"
      leicht="<p>Wir machen zwei Mal im Jahr einen Spaziergang. Wir nennen ihn „Walk“. Wir gehen gemeinsam durch Graz und besuchen Ausstellungen. Dabei schauen wir genau: Können hier alle Menschen gut mitmachen?</p>"
    />
    {events.length > 0 ? (
      <ul class="grid gap-8 sm:grid-cols-2">
        {events.map((event) => {
          const eventDate = new Date(event.data.start_date);
          return (
            <li class="rounded-[2.5rem] border border-sumi-900/10 bg-washi p-8 transition hover:-translate-y-1">
              <article class="flex items-start gap-6">
                <div class="shrink-0">
                  <span class="block font-serif text-5xl font-bold tracking-tighter text-sumi-900">
                    {eventDate.getDate()}.
                  </span>
                  <span class="ll-fade mt-1 block text-xs font-semibold tracking-widest text-sumi-600 uppercase">
                    {eventDate.toLocaleDateString('de-AT', { month: 'long' })}
                  </span>
                </div>
                <div>
                  <h2 class="text-xl font-bold text-sumi-900">
                    <a href={`/events/${event.slug}`} class="hover:text-kuin-magenta">{event.data.title}</a>
                  </h2>
                  <p class="mt-2 flex items-center gap-2 text-sm text-sumi-600">
                    <svg class="h-4 w-4 shrink-0 text-kuin-magenta" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    {event.data.location}
                  </p>
                  {event.data.accessibility_features?.length > 0 && (
                    <ul class="mt-3 flex flex-wrap gap-2" aria-label="Barrierefreiheit">
                      {event.data.accessibility_features.map((f: string) => (
                        <li class="rounded-full border border-matcha-dark bg-matcha/10 px-3 py-1 text-xs font-semibold text-matcha-dark">{f}</li>
                      ))}
                    </ul>
                  )}
                </div>
              </article>
            </li>
          );
        })}
      </ul>
    ) : (
      <p class="text-sumi-600"><em>Derzeit sind keine Veranstaltungen geplant.</em></p>
    )}
  </main>
</Layout>
