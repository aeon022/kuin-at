---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'orbiter:collections';
import { EventSchema } from '../../schemas';
import { parseEntries } from '../../lib/content';
import { dateParts, formatTimeRange, isPast } from '../../lib/eventTime';
import ProseSwap from '../../components/ProseSwap.astro';

const all = parseEntries('events', await getCollection('events'), EventSchema)
  .map((e) => ({ slug: e.slug, ...e.data, d: dateParts(e.data.start_date), time: formatTimeRange(e.data.start_date, e.data.end_date) }))
  .sort((a, b) => new Date(a.start_date).getTime() - new Date(b.start_date).getTime());

const upcoming = all.filter((e) => !isPast(e.start_date, e.end_date));
const past = all.filter((e) => isPast(e.start_date, e.end_date)).reverse();
const [next, ...later] = upcoming;

// later events grouped by month, in order
const months = later.reduce<{ key: string; label: string; items: typeof later }[]>((acc, e) => {
  const last = acc[acc.length - 1];
  if (last?.key === e.d.monthKey) last.items.push(e);
  else acc.push({ key: e.d.monthKey, label: `${e.d.month} ${e.d.year}`, items: [e] });
  return acc;
}, []);
---
<Layout title="Veranstaltungen" description="Kommende Veranstaltungen von Kultur Inklusiv in Graz: Workshops, Konferenz und inklusive Kulturspaziergänge." active="events">
  <main id="main" class="mx-auto max-w-5xl px-4 py-16 md:py-24">
    <h1 class="mb-4 text-4xl font-bold text-sumi-900 md:text-5xl">Veranstaltungen</h1>
    <ProseSwap
      class="mb-14 max-w-2xl text-lg text-sumi-600"
      standard="<p>Zwei Mal im Jahr organisiert Kultur Inklusiv den „Walk“. Dieser Rundgang ist als inklusiver kultureller Spaziergang durch die Stadt gestaltet. Er umfasst mehrere Ausstellungen und Veranstaltungen. Wir erforschen gemeinsam den Stadtraum und machen kulturelle Barrierefreiheit aktiv erlebbar.</p>"
      leicht="<p>Wir machen zwei Mal im Jahr einen Spaziergang. Wir nennen ihn „Walk“. Wir gehen gemeinsam durch Graz und besuchen Ausstellungen. Dabei schauen wir genau: Können hier alle Menschen gut mitmachen?</p>"
    />

    {next ? (
      <>
        <!-- Next up: the one event people most need to find, so it gets the room. -->
        <article class="group relative mb-16 grid gap-8 rounded-[2.5rem] bg-kuin-soft p-8 md:grid-cols-[auto_1fr] md:gap-14 md:p-12">
          <div class="md:w-44">
            <p class="font-serif text-8xl leading-none font-bold tracking-tighter text-sumi-900 md:text-9xl" aria-hidden="true">{next.d.day}.</p>
            <p class="mt-3 text-lg font-semibold text-sumi-900">{next.d.weekday}</p>
            <p class="text-sumi-600">{next.d.month} {next.d.year}</p>
          </div>
          <div class="flex flex-col gap-4">
            <p class="text-sm font-semibold text-kuin-dark">Nächster Termin</p>
            <h2 class="text-3xl leading-tight font-bold text-sumi-900 md:text-4xl">
              <a href={`/events/${next.slug}`} class="after:absolute after:inset-0 after:content-[''] hover:text-kuin-dark">{next.title}</a>
            </h2>
            <p class="font-medium text-sumi-900">{next.location}{next.time && <>, {next.time}</>}</p>
            {next.accessibility_features.length > 0 && (
              <ul class="flex flex-wrap gap-2" aria-label="Barrierefreiheit">
                {next.accessibility_features.map((f) => (
                  <li class="rounded-full border border-matcha-700/30 bg-matcha-100 px-4 py-1.5 text-sm font-semibold text-matcha-900">{f}</li>
                ))}
              </ul>
            )}
            <p class="mt-2 font-semibold text-magenta-dark">Details ansehen <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-1">→</span></p>
          </div>
        </article>

        {months.map((m) => (
          <section class="mb-12" aria-labelledby={`m-${m.key}`}>
            <h2 id={`m-${m.key}`} class="mb-2 font-sans text-sm font-bold tracking-wide text-sumi-600">{m.label}</h2>
            <ul>
              {m.items.map((e) => (
                <li class="group relative grid grid-cols-[4.5rem_1fr] gap-x-5 border-t border-sumi-400/20 py-6 md:grid-cols-[7rem_1fr] md:gap-x-8">
                  <div>
                    <p class="font-serif text-5xl leading-none font-bold tracking-tighter text-sumi-900 transition-colors group-hover:text-kuin-magenta md:text-6xl" aria-hidden="true">{e.d.day}.</p>
                    <p class="ll-fade mt-1 text-sm text-sumi-600">{e.d.weekday}</p>
                  </div>
                  <div class="flex flex-col gap-2">
                    <h3 class="text-xl leading-snug font-bold text-sumi-900 md:text-2xl">
                      <a href={`/events/${e.slug}`} class="after:absolute after:inset-0 after:content-[''] group-hover:text-kuin-dark">
                        <span class="sr-only">{e.d.weekday}, {e.d.day}. {e.d.month}: </span>{e.title}
                      </a>
                    </h3>
                    <p class="text-sumi-600">{e.location}{e.time && <>, {e.time}</>}</p>
                    {e.accessibility_features.length > 0 && (
                      <ul class="flex flex-wrap gap-2" aria-label="Barrierefreiheit">
                        {e.accessibility_features.map((f) => (
                          <li class="rounded-full border border-matcha-700/30 bg-matcha-100 px-3 py-1 text-xs font-semibold text-matcha-900">{f}</li>
                        ))}
                      </ul>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </>
    ) : (
      <p class="mb-16 rounded-[2.5rem] bg-kuin-soft p-8 text-sumi-900">Derzeit sind keine Veranstaltungen geplant. Neue Termine erscheinen hier, sobald sie feststehen.</p>
    )}

    {past.length > 0 && (
      <details class="group border-t border-sumi-400/20 pt-6">
        <summary class="cursor-pointer list-none font-semibold text-magenta-dark hover:text-kuin-dark">
          <span class="inline-flex items-center gap-2">Vergangene Veranstaltungen ({past.length}) <span aria-hidden="true" class="transition-transform group-open:rotate-180">▾</span></span>
        </summary>
        <ul class="mt-4">
          {past.map((e) => (
            <li class="border-t border-sumi-400/10 py-4 first:border-t-0">
              <a href={`/events/${e.slug}`} class="font-semibold text-sumi-900 underline decoration-sumi-400/40 underline-offset-4 hover:text-kuin-dark">{e.title}</a>
              <p class="text-sm text-sumi-600">{e.d.day}. {e.d.month} {e.d.year}, {e.location}</p>
            </li>
          ))}
        </ul>
      </details>
    )}
  </main>
</Layout>
