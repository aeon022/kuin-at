---
import Layout from '../../layouts/Layout.astro';
import { getEntry } from 'orbiter:collections';
import { EventSchema } from '../../schemas';
import ProseSwap from '../../components/ProseSwap.astro';
import { getCollection } from 'orbiter:collections';
import { parseEntries } from '../../lib/content';
import { dateParts, formatTimeRange, isPast } from '../../lib/eventTime';

const { slug } = Astro.params;
const entry = await getEntry('events', slug!);
// getEntry() also returns drafts (only the collection lists filter by status) — unpublished must 404.
if (!entry || (entry as { status?: string }).status !== 'published') return Astro.redirect('/404');

// Malformed CMS data must not 500 the public page — treat it like "not found".
const parsed = EventSchema.safeParse(entry.data);
if (!parsed.success) {
  console.warn(`events/${slug}: invalid entry data, redirecting to /404`, parsed.error.issues);
  return Astro.redirect('/404');
}
const data = parsed.data;
const startDate = new Date(data.start_date);
const endDate = new Date(data.end_date);
const timeRange = formatTimeRange(data.start_date, data.end_date);
const d = dateParts(data.start_date);
const over = isPast(data.start_date, data.end_date);
// up to two other upcoming events, to keep people moving through the programme
const others = parseEntries('events', await getCollection('events'), EventSchema)
  .filter((e) => e.slug !== slug && !isPast(e.data.start_date, e.data.end_date))
  .sort((a, b) => new Date(a.data.start_date).getTime() - new Date(b.data.start_date).getTime())
  .slice(0, 2)
  .map((e) => ({ slug: e.slug, title: e.data.title, d: dateParts(e.data.start_date) }));
---
<Layout title={data.title} description={`${d.weekday}, ${d.day}. ${d.month} ${d.year}${timeRange ? `, ${timeRange}` : ''} – ${data.location}`} active="events">
  <main id="main" class="mx-auto max-w-5xl px-4 py-16 md:py-24">
    <a href="/events" class="inline-flex items-center gap-2 text-sm font-semibold text-sumi-600 transition-colors hover:text-kuin-magenta">
      <span aria-hidden="true">←</span> Alle Veranstaltungen
    </a>

    <article class="mt-8 grid gap-10 lg:grid-cols-[17rem_1fr] lg:gap-16">
      <!-- The date is the spine of this site's event pages: big numeral, then the facts people plan around. -->
      <aside class="lg:sticky lg:top-8 lg:self-start" aria-label="Termin und Ort">
        <div class="rounded-[2.5rem] bg-kuin-soft p-8">
          <p class="sr-only"><time datetime={data.start_date}>{d.weekday}, {d.day}. {d.month} {d.year}</time></p>
          <p class="font-serif text-8xl leading-none font-bold tracking-tighter text-sumi-900" aria-hidden="true">{d.day}.</p>
          <p class="mt-3 text-lg font-semibold text-sumi-900">{d.weekday}</p>
          <p class="text-sumi-600">{d.month} {d.year}</p>
        </div>
        <dl class="mt-6 space-y-5">
          {timeRange && (
            <div>
              <dt class="text-sm font-semibold text-sumi-600">Zeit</dt>
              <dd class="font-medium text-sumi-900">{timeRange}</dd>
            </div>
          )}
          <div>
            <dt class="text-sm font-semibold text-sumi-600">Ort</dt>
            <dd class="font-medium text-sumi-900">{data.location}</dd>
          </div>
          {data.accessibility_features.length > 0 && (
            <div>
              <dt class="mb-2 text-sm font-semibold text-sumi-600">Barrierefreiheit</dt>
              <dd>
                <ul class="flex flex-wrap gap-2">
                  {data.accessibility_features.map((f) => (
                    <li class="rounded-full border border-matcha-700/30 bg-matcha-100 px-3 py-1 text-sm font-semibold text-matcha-900">{f}</li>
                  ))}
                </ul>
              </dd>
            </div>
          )}
        </dl>
      </aside>

      <div class="max-w-2xl">
        <h1 class="mb-6 text-4xl leading-tight font-bold text-sumi-900 md:text-5xl">{data.title}</h1>
        {over && (
          <p class="mb-6 rounded-2xl border border-sumi-400/30 px-5 py-3 text-sumi-600" role="note">Diese Veranstaltung hat bereits stattgefunden.</p>
        )}
        <ProseSwap standard={data.description_standard} leicht={data.description_leicht_lesen} />
      </div>
    </article>

    {others.length > 0 && (
      <section class="mt-20 border-t border-sumi-400/20 pt-10" aria-labelledby="mehr">
        <h2 id="mehr" class="mb-6 text-2xl font-bold text-sumi-900">Weitere Termine</h2>
        <ul class="grid gap-4 sm:grid-cols-2">
          {others.map((e) => (
            <li class="group relative flex items-baseline gap-4 rounded-2xl bg-sumi-900/[0.03] p-5 transition hover:-translate-y-1">
              <span class="font-serif text-4xl leading-none font-bold text-sumi-900 transition-colors group-hover:text-kuin-magenta" aria-hidden="true">{e.d.day}.</span>
              <span>
                <span class="block text-sm text-sumi-600">{e.d.month} {e.d.year}</span>
                <a href={`/events/${e.slug}`} class="font-semibold text-sumi-900 after:absolute after:inset-0 after:content-[''] hover:text-kuin-dark">{e.title}</a>
              </span>
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>
</Layout>
