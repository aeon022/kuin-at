---
// Client request 2026-09: "Archiv | 3 Unterkategorien: Veranstaltungen |
// Newsletter | Jahresberichte".
//
// Judgment call on "Veranstaltungen": this section keeps rendering the
// `archive` collection (year galleries) rather than querying past `events`.
// The client described the archive as "Die vergangenen Events werden mit
// Fotos dann im Archiv angezeigt" — photo galleries of past events, which is
// exactly what ArchiveSchema models (title, year, description, images with
// alt text). Individual past `events` entries stay listed on /events; if the
// client later wants them pulled in here automatically, filter `events` by
// `end_date < now` and render them alongside the galleries.
//
// "Jahresberichte" reuses the existing `downloads` collection, filtered to
// category:"jahresbericht" (see DownloadSchema) — /downloads itself shows the
// full unfiltered list (all categories), so this section only ever shows the
// subset that's actually a yearly report instead of duplicating everything.
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'orbiter:collections';
import { getMediaItem } from 'orbiter:media';
import { ArchiveSchema, DownloadSchema } from '../../schemas';
import { parseEntries } from '../../lib/content';

const archives = parseEntries('archive', await getCollection('archive'), ArchiveSchema)
  .sort((a, b) => b.data.year - a.data.year);

// The 25 migrated blog posts are the newsletter archive (their slugs are
// literally `newsletter-*`) — same list as /blog. Shown here as a short
// preview plus an expandable drawer for the rest, instead of duplicating
// the full 25-item wall of links that /blog already owns.
const NEWSLETTER_PREVIEW = 5;
const newsletters = (await getCollection('blog'))
  .filter((p) => p.data.published_at)
  .sort((a, b) => new Date(b.data.published_at).getTime() - new Date(a.data.published_at).getTime());
const newsletterPreview = newsletters.slice(0, NEWSLETTER_PREVIEW);
const newsletterRest = newsletters.slice(NEWSLETTER_PREVIEW);

const reports = await Promise.all(
  parseEntries('downloads', await getCollection('downloads'), DownloadSchema)
    .filter((e) => e.data.category === 'jahresbericht')
    .map(async (e) => ({ ...e.data, fileMedia: await getMediaItem(e.data.file) })),
);
const resolvedReports = reports.filter((r) => r.fileMedia);
---
<Layout title="Archiv" active="archiv">
  <main id="main" class="mx-auto max-w-5xl px-4 py-16 md:py-24">
    <h1 class="mb-16 text-4xl font-bold md:text-5xl">Archiv — Rückblicke</h1>

    <section class="mb-20">
      <h2 class="mb-4 text-2xl font-semibold">Veranstaltungen</h2>
      {archives.length > 0 ? (
        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {archives.map(({ slug, data: archive }) => (
            <a href={`/archiv/${slug}`} class="group block">
              <article>
                <div class="grid grid-cols-2 gap-1 overflow-hidden rounded-2xl bg-sumi-900/5">
                  {archive.images.slice(0, 4).map((img) => (
                    <div class="aspect-square overflow-hidden">
                      <img src={img.image_url} alt="" loading="lazy" class="h-full w-full object-cover grayscale transition-all duration-500 group-hover:grayscale-0" />
                    </div>
                  ))}
                </div>
                <h3 class="mt-4 text-xl font-semibold group-hover:text-kuin-magenta">{archive.title} ({archive.year})</h3>
                <p class="text-sm text-sumi-600">{archive.images.length} Fotos</p>
              </article>
            </a>
          ))}
        </div>
      ) : (
        <p class="text-sumi-600"><em>Derzeit sind keine vergangenen Veranstaltungen archiviert.</em></p>
      )}
    </section>

    <section class="mb-20">
      <h2 class="mb-4 text-2xl font-semibold">Newsletter</h2>
      {newsletters.length > 0 ? (
        <>
          <ul class="flex flex-col gap-4">
            {newsletterPreview.map((post) => (
              <li class="rounded-2xl bg-sumi-900/[0.03] p-4 transition hover:-translate-y-1 hover:bg-washi hover:shadow-md">
                <article>
                  <h3 class="text-lg font-semibold">
                    <a href={`/blog/${post.slug}`} class="text-magenta-dark underline hover:text-kuin-magenta">{post.data.title}</a>
                  </h3>
                  <time datetime={post.data.published_at} class="ll-fade text-sm text-sumi-600">
                    {new Date(post.data.published_at).toLocaleDateString('de-AT', { year: 'numeric', month: 'long', day: 'numeric' })}
                  </time>
                </article>
              </li>
            ))}
          </ul>
          {newsletterRest.length > 0 && (
            <details class="group mt-4">
              <summary class="cursor-pointer list-none text-sm font-semibold text-magenta-dark hover:text-kuin-magenta">
                <span class="inline-flex items-center gap-1.5">
                  Ältere Newsletter anzeigen ({newsletterRest.length})
                  <span class="transition-transform group-open:rotate-180">▾</span>
                </span>
              </summary>
              <ul class="mt-4 flex flex-col gap-4">
                {newsletterRest.map((post) => (
                  <li class="rounded-2xl bg-sumi-900/[0.03] p-4 transition hover:-translate-y-1 hover:bg-washi hover:shadow-md">
                    <article>
                      <h3 class="text-lg font-semibold">
                        <a href={`/blog/${post.slug}`} class="text-magenta-dark underline hover:text-kuin-magenta">{post.data.title}</a>
                      </h3>
                      <time datetime={post.data.published_at} class="ll-fade text-sm text-sumi-600">
                        {new Date(post.data.published_at).toLocaleDateString('de-AT', { year: 'numeric', month: 'long', day: 'numeric' })}
                      </time>
                    </article>
                  </li>
                ))}
              </ul>
            </details>
          )}
        </>
      ) : (
        <p class="text-sumi-600"><em>Derzeit sind keine Newsletter archiviert.</em></p>
      )}
    </section>

    <section>
      <h2 class="mb-4 text-2xl font-semibold">Jahresberichte</h2>
      {resolvedReports.length > 0 ? (
        <ul class="flex flex-col gap-4">
          {resolvedReports.map((r) => (
            <li class="flex items-baseline justify-between gap-4 rounded-2xl bg-sumi-900/[0.03] p-5">
              <div>
                <p class="font-medium">{r.title}</p>
                {r.description && <p class="text-sm text-sumi-600">{r.description}</p>}
              </div>
              <a href={r.fileMedia?.url} class="shrink-0 rounded-2xl bg-magenta-dark px-3 py-1.5 text-sm text-washi transition hover:-translate-y-0.5 hover:bg-kuin-magenta">
                Herunterladen
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <a href="/downloads" class="group flex items-center justify-between gap-4 rounded-2xl bg-sumi-900/[0.03] p-5 transition hover:-translate-y-1 hover:bg-washi hover:shadow-md">
          <p class="text-sumi-600">Noch keine Jahresberichte veröffentlicht — alle Formulare &amp; Dokumente gibt es unter Downloads.</p>
          <span class="shrink-0 font-semibold text-magenta-dark group-hover:text-kuin-magenta">Zu Downloads →</span>
        </a>
      )}
    </section>
  </main>
</Layout>
