---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'orbiter:collections';
import { getMediaItem } from 'orbiter:media';
import { PartnerSchema } from '../../schemas';
import { parseEntries } from '../../lib/content';

const partners = parseEntries('partners', await getCollection('partners'), PartnerSchema).map((e) => e.data);
const withLogos = await Promise.all(
  partners.map(async (p) => ({ ...p, logoMedia: await getMediaItem(p.logo) }))
);
// A partner whose logo media-id doesn't resolve would render src="undefined" —
// skip it entirely rather than ship a broken image.
const resolved = withLogos.filter((p) => p.logoMedia);
const board = resolved.filter((p) => p.is_board_member);
const network = resolved.filter((p) => !p.is_board_member);
---
<Layout title="Mitglieder" active="partner">
  <main id="main" class="mx-auto max-w-5xl px-4 py-16 md:py-24">
    <h1 class="mb-16 text-4xl font-bold md:text-5xl">Mitglieder</h1>

    {board.length > 0 && (
      <section class="mb-16">
        <h2 class="mb-8 text-sm font-bold tracking-widest text-sumi-600 uppercase">Vorstand</h2>
        <ul class="grid grid-cols-2 gap-6 sm:grid-cols-4">
          {board.map((p) => (
            <li class="flex flex-col items-center gap-2 rounded-2xl bg-sumi-900/[0.03] p-6 transition hover:-translate-y-1">
              <img src={p.logoMedia?.url} alt={p.name} class="logo-wall-img h-16 object-contain grayscale transition hover:grayscale-0" />
              <span class="text-sm">{p.name}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section>
      <h2 class="mb-8 text-sm font-bold tracking-widest text-sumi-600 uppercase">Netzwerk</h2>
      <ul class="grid grid-cols-2 gap-6 sm:grid-cols-4">
        {network.map((p) => (
          <li class="flex flex-col items-center gap-2 rounded-2xl bg-sumi-900/[0.03] p-6 transition hover:-translate-y-1">
            {p.website_url
              ? <a href={p.website_url} target="_blank" rel="noopener noreferrer"><img src={p.logoMedia?.url} alt={p.name} class="logo-wall-img h-16 object-contain grayscale transition hover:grayscale-0" /></a>
              : <img src={p.logoMedia?.url} alt={p.name} class="logo-wall-img h-16 object-contain grayscale transition hover:grayscale-0" />}
            <span class="text-sm">{p.name}</span>
          </li>
        ))}
      </ul>
    </section>
  </main>
</Layout>
