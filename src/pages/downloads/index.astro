---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'orbiter:collections';
import { getMediaItem } from 'orbiter:media';
import { DownloadSchema } from '../../schemas';
import { parseEntries } from '../../lib/content';

const parsed = parseEntries('downloads', await getCollection('downloads'), DownloadSchema).map((e) => e.data);
const withFiles = await Promise.all(
  parsed.map(async (d) => ({ ...d, fileMedia: await getMediaItem(d.file) }))
);
// A download whose file media-id doesn't resolve would render href="undefined" —
// skip the row rather than ship a dead link.
const downloads = withFiles.filter((d) => d.fileMedia);

// Grouped by the free-text `category` field (Orbiter admin) so the list stays
// organized as it grows — same "jahresbericht" value is also what /archiv
// filters on for its own "Jahresberichte" section.
const GROUPS = [
  { key: 'jahresbericht', label: 'Jahresberichte' },
  { key: 'formular', label: 'Formulare' },
] as const;
const grouped = GROUPS.map((g) => ({ ...g, items: downloads.filter((d) => d.category === g.key) }))
  .filter((g) => g.items.length > 0);
const known = new Set(GROUPS.map((g) => g.key));
const other = downloads.filter((d) => !known.has(d.category as any));
---
<Layout title="Downloads">
  <main id="main" class="mx-auto max-w-3xl space-y-12 px-4 py-16 md:py-24">
    <h1 class="text-4xl font-bold md:text-5xl">Downloads</h1>
    {downloads.length === 0 && <p class="text-sumi-600"><em>Derzeit sind keine Downloads verfügbar.</em></p>}
    {grouped.map((g) => (
      <section>
        <h2 class="mb-4 text-2xl font-semibold">{g.label}</h2>
        <ul class="flex flex-col gap-4">
          {g.items.map((d) => (
            <li class="flex items-baseline justify-between gap-4 rounded-2xl bg-sumi-900/[0.03] p-5">
              <div>
                <p class="font-medium">{d.title}</p>
                {d.description && <p class="text-sm text-sumi-600">{d.description}</p>}
              </div>
              <a href={d.fileMedia?.url} class="shrink-0 rounded-2xl bg-magenta-dark px-3 py-1.5 text-sm text-washi transition hover:-translate-y-0.5 hover:bg-kuin-magenta">
                Herunterladen
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
    {other.length > 0 && (
      <section>
        {grouped.length > 0 && <h2 class="mb-4 text-2xl font-semibold">Sonstiges</h2>}
        <ul class="flex flex-col gap-4">
          {other.map((d) => (
            <li class="flex items-baseline justify-between gap-4 rounded-2xl bg-sumi-900/[0.03] p-5">
              <div>
                <p class="font-medium">{d.title}</p>
                {d.description && <p class="text-sm text-sumi-600">{d.description}</p>}
              </div>
              <a href={d.fileMedia?.url} class="shrink-0 rounded-2xl bg-magenta-dark px-3 py-1.5 text-sm text-washi transition hover:-translate-y-0.5 hover:bg-kuin-magenta">
                Herunterladen
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>
</Layout>
