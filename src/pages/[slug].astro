---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, getEntry } from 'orbiter:collections';
import { getDisplayContent, parseEntries } from '../lib/content';
import { PageSchema, PartnerSchema } from '../schemas';

const { slug } = Astro.params;
const entry = await getEntry('pages', slug!);
if (!entry) return Astro.redirect('/404');

// Malformed CMS data must not 500 the public page — treat it like "not found".
const parsed = PageSchema.safeParse(entry.data);
if (!parsed.success) {
  console.warn(`pages/${slug}: invalid entry data, redirecting to /404`, parsed.error.issues);
  return Astro.redirect('/404');
}
const data = parsed.data;
const leichtLesenActive = Astro.cookies.get('kuin-leicht-lesen')?.value === 'true';
const content = getDisplayContent(data, 'content_standard', 'content_leicht_lesen', leichtLesenActive);

// The Kontakt page additionally shows the board and a named contact for
// inquiries — requested directly by the client, not derivable from the
// legacy WP data. Board names are pulled live from Partners
// (is_board_member) rather than hardcoded, so the list stays correct as
// the board changes; the contact name/email is fixed on this one page.
const isKontakt = slug === 'kontakt';
const board = isKontakt
  ? parseEntries('partners', await getCollection('partners'), PartnerSchema).map((e) => e.data).filter((p) => p.is_board_member)
  : [];

// Highlight the matching nav item for the two Pages entries that have one
// (Header.astro's link ids: 'ueber-uns' for /der-verein, 'kontakt' for
// /kontakt); every other migrated page has no nav entry, so no highlight.
const navIdBySlug: Record<string, string> = { 'der-verein': 'ueber-uns', kontakt: 'kontakt' };
const active = navIdBySlug[slug!];
---
<BaseLayout title={data.title} description={data.seo_description} active={active}>
  <main class="mx-auto max-w-3xl px-4 py-10">
    <h1 class="mb-6 text-3xl font-bold text-sumi-900">{data.title}</h1>
    <article class="prose" set:html={content} />

    {isKontakt && (
      <section class="mt-10 border-t border-sumi-900/10 pt-8">
        <h2 class="mb-4 text-xl font-semibold text-sumi-900">Vorstand</h2>
        {board.length > 0 ? (
          <ul class="mb-6 flex flex-wrap gap-x-6 gap-y-1">
            {board.map((p) => <li>{p.name}</li>)}
          </ul>
        ) : (
          <p class="mb-6 text-sumi-600"><em>[TODO: Vorstandsmitglieder in der Partners-Collection als is_board_member eintragen — ein Vorstandsfoto kann direkt im Rich-Text-Editor dieser Seite ergänzt werden.]</em></p>
        )}
        <p class="text-sumi-900">
          Für Anfragen wenden Sie sich bitte an <strong>Anita Brodtrager</strong>:
          {' '}<a href="mailto:office@kuin.at" class="text-magenta-dark underline hover:text-kuin-magenta">office@kuin.at</a>
        </p>
      </section>
    )}
  </main>
</BaseLayout>
