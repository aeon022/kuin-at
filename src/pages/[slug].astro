---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'orbiter:collections';
import { PageSchema } from '../schemas';
import ProseSwap from '../components/ProseSwap.astro';

const { slug } = Astro.params;
const entry = await getEntry('pages', slug!);
if (!entry) return Astro.redirect('/404');

// Malformed CMS data must not 500 the public page — treat it like "not found".
const parsed = PageSchema.safeParse(entry.data);
if (!parsed.success) {
  console.warn(`pages/${slug}: invalid entry data, redirecting to /404`, parsed.error.issues);
  return Astro.redirect('/404');
}
const data = parsed.data;

// The Kontakt page additionally shows a named contact for inquiries —
// requested directly by the client, not derivable from the legacy WP
// data. Real board members now live on /der-verein/vorstand (the
// `people` collection, category "vorstand") — linked from here instead
// of duplicated, so there's one source of truth for who's on the board.
const isKontakt = slug === 'kontakt';

// Highlight the matching nav item for the two Pages entries that have one
// (Header.astro's link ids: 'ueber-uns' for /der-verein, 'kontakt' for
// /kontakt); every other migrated page has no nav entry, so no highlight.
const navIdBySlug: Record<string, string> = { 'der-verein': 'ueber-uns', kontakt: 'kontakt' };
const active = navIdBySlug[slug!];
---
<Layout title={data.title} description={data.seo_description} active={active}>
  <main id="main" class="mx-auto max-w-3xl px-4 py-16 md:py-24">
    <h1 class="mb-8 text-4xl font-bold text-sumi-900 md:text-5xl">{data.title}</h1>
    <ProseSwap standard={data.content_standard} leicht={data.content_leicht_lesen} />

    {isKontakt && (
      <section class="mt-10 border-t border-sumi-900/10 pt-8">
        <h2 class="mb-4 text-xl font-semibold text-sumi-900">Vorstand</h2>
        <p class="mb-6 text-sumi-600">
          Den Vorstand stellen wir auf <a href="/der-verein/vorstand" class="text-magenta-dark underline hover:text-kuin-magenta">der Vorstandsseite</a> vor.
        </p>
        <p class="text-sumi-900">
          Für Anfragen wenden Sie sich bitte an <strong>Anita Brodtrager</strong>:
          {' '}<a href="mailto:office@kuin.at" class="text-magenta-dark underline hover:text-kuin-magenta">office@kuin.at</a>
        </p>
      </section>

      <section class="mt-10 border-t border-sumi-900/10 pt-8">
        <h2 class="mb-4 text-xl font-semibold text-sumi-900">Schreib uns</h2>
        <form
          data-form-id="kontakt"
          action={`${import.meta.env.PUBLIC_ORBITER_ADMIN_URL}/api/form/kontakt`}
          method="POST"
          class="max-w-xl space-y-4"
        >
          <input type="text" name="_honeypot" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <div>
            <label for="kontakt-name" class="mb-1 block text-sm font-medium text-sumi-900">Name</label>
            <input id="kontakt-name" name="name" type="text" required class="w-full rounded-xl border border-sumi-900/15 bg-white px-4 py-2.5 text-sumi-900 outline-none" />
          </div>
          <div>
            <label for="kontakt-email" class="mb-1 block text-sm font-medium text-sumi-900">E-Mail</label>
            <input id="kontakt-email" name="email" type="email" required class="w-full rounded-xl border border-sumi-900/15 bg-white px-4 py-2.5 text-sumi-900 outline-none" />
          </div>
          <div>
            <label for="kontakt-message" class="mb-1 block text-sm font-medium text-sumi-900">Nachricht</label>
            <textarea id="kontakt-message" name="message" required rows="5" class="w-full rounded-xl border border-sumi-900/15 bg-white px-4 py-2.5 text-sumi-900 outline-none"></textarea>
          </div>
          <button type="submit" class="rounded-2xl bg-magenta-dark px-6 py-3 font-medium text-washi transition hover:-translate-y-1 hover:bg-kuin-magenta">
            Absenden
          </button>
          <p data-form-status hidden></p>
        </form>
      </section>
    )}
  </main>
</Layout>

{isKontakt && (
  <script>
    import { wireOrbiterForm } from '../lib/orbiterForm';
    const form = document.querySelector('form[data-form-id="kontakt"]');
    if (form instanceof HTMLFormElement) wireOrbiterForm(form);
  </script>
)}
