---
import Layout from '../../layouts/Layout.astro';
import { getEntry } from 'orbiter:collections';
import { getMediaItem } from 'orbiter:media';
import { BlogPostSchema } from '../../schemas';
import ProseSwap from '../../components/ProseSwap.astro';

const { slug } = Astro.params;
const entry = await getEntry('blog', slug!);
if (!entry) return Astro.redirect('/404');

// Malformed CMS data must not 500 the public page — treat it like "not found".
const parsed = BlogPostSchema.safeParse(entry.data);
if (!parsed.success) {
  console.warn(`blog/${slug}: invalid entry data, redirecting to /404`, parsed.error.issues);
  return Astro.redirect('/404');
}
const data = parsed.data;
const coverImage = data.cover_image ? await getMediaItem(data.cover_image) : null;
---
<Layout title={data.title} active="events">
  <main id="main" class="mx-auto max-w-3xl space-y-6 px-4 py-16 md:py-24">
    <a href="/blog" class="inline-flex items-center gap-2 text-sm font-semibold text-sumi-600 transition-colors hover:text-kuin-magenta">
      ← Alle Beiträge
    </a>
    <article>
      <h1 class="mb-3 text-4xl font-bold md:text-5xl">{data.title}</h1>
      <time datetime={data.published_at} class="mb-6 block text-sm text-sumi-600">
        {new Date(data.published_at).toLocaleDateString('de-AT', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
      {coverImage && (
        <img src={coverImage.url} alt={data.title} class="mb-6 rounded-2xl" />
      )}
      <ProseSwap standard={data.content_standard} leicht={data.content_leicht_lesen} />
    </article>
  </main>
</Layout>
