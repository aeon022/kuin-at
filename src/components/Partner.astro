---
// Partner.astro — mockup.html §5 "Partner / Netzwerk" layout/classes, filled
// with the real Orbiter partners collection (16 real organizations, real
// logos migrated from WordPress) instead of the mockup's four invented
// text wordmarks ("Lebenshilfe", "Diakonie", …). The mockup rendered plain
// text since it had no logo assets to work with — here we have real logo
// images, so each item is an <img> instead of a text label.
import { getCollection } from 'orbiter:collections';
import { getMediaItem } from 'orbiter:media';
import { PartnerSchema } from '../schemas';
import { parseEntries } from '../lib/content';

const partners = parseEntries('partners', await getCollection('partners'), PartnerSchema)
  .map((e) => ({ ...e.data, slug: e.slug }));
const withLogos = await Promise.all(
  partners.map(async (p) => ({ ...p, logoMedia: await getMediaItem(p.logo) })),
);
const network = withLogos.filter((p) => p.logoMedia);

// Per-logo scale overrides (client request 2026-09): Pupella's source file
// has a lot of internal padding baked in, AXE Graz's has almost none — the
// shared fixed box (h-14 w-40, see the big comment below) makes every logo
// occupy the same *footprint*, but can't fix a source file's own internal
// whitespace, so those two still read as visibly smaller/bigger than their
// neighbours. A CSS scale transform on just these two nudges them back in
// line without touching the shared box every other logo relies on.
const logoScale: Record<string, string> = {
  pupella: 'scale-125',
  'axe-graz': 'scale-75',
};
---
<section id="partner" class="breathing-element border-t border-sumi-400/10 pt-24">
  <h2 class="mb-12 text-center font-sans text-sm font-bold tracking-widest text-sumi-400 uppercase">Unsere Mitglieder</h2>

  <!-- Fixed bounding box per logo, not `h-10 w-auto` — source files vary
       wildly in internal padding (a tight icon mark vs. a wide wordmark
       with lots of breathing room baked into the file), so equal *height*
       alone still read as wildly different *sizes*. object-contain inside
       an equal box makes every logo occupy the same footprint regardless
       of its own aspect ratio.
       h-12→h-20 (client: "too small") then h-20→h-14 (client: "some too
       big, looks patchy") — h-20 over-corrected: object-contain scales a
       WIDE/short wordmark against the box's *height* (so it grew ~65%
       right along with the box) but scales a square/round icon mark
       against the box's *width* instead (barely changed), so the two
       logo shapes drifted apart in rendered size rather than together.
       h-14 keeps the recognizability win without repeating that split.
       Resting opacity raised 60% → 75% in the same pass — grayscale at
       60% was compounding the same complaint on top of size. -->
  <ul id="partner-list" class="flex flex-wrap items-center justify-center gap-x-12 gap-y-8 opacity-75 transition-opacity duration-500 hover:opacity-100 md:gap-x-20">
    {network.map((p, i) => (
      <li data-reveal style={`transition-delay: ${Math.min(i, 10) * 60}ms`} class="reveal-item flex h-14 w-40 shrink-0 items-center justify-center opacity-0 translate-y-3 transition-[opacity,transform] duration-500 ease-out">
        {p.website_url ? (
          <a href={p.website_url} target="_blank" rel="noopener noreferrer" title={p.name} class="flex h-full w-full items-center justify-center transition hover:-translate-y-1">
            <img src={p.logoMedia?.url} alt={p.logoMedia?.alt ?? p.name} class:list={['logo-wall-img max-h-full max-w-full object-contain grayscale transition hover:grayscale-0', logoScale[p.slug]]} />
          </a>
        ) : (
          <img src={p.logoMedia?.url} alt={p.logoMedia?.alt ?? p.name} class:list={['logo-wall-img max-h-full max-w-full object-contain grayscale', logoScale[p.slug]]} />
        )}
      </li>
    ))}
  </ul>
</section>

<script>
  // Partner only exists on "/" — same astro:page-load requirement as
  // Hero.astro (see its script comment): this whole block re-runs fresh
  // on every navigation to "/", including the first.
  document.addEventListener('astro:page-load', () => {
  // Scroll-reveal, one IntersectionObserver for the whole logo wall rather
  // than one per <li> — each item fades/rises in with a small stagger
  // (inline transition-delay set server-side above, capped at 10 items so
  // a 16-logo wall doesn't end with a visibly long tail). Skipped entirely
  // under reduced-motion (site-wide toggle or OS setting) — items just
  // render already visible, same as everywhere else on the site that
  // checks this.
  const reduced = document.documentElement.hasAttribute('data-reduce-motion') || window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const items = document.querySelectorAll('#partner-list [data-reveal]');

  if (reduced) {
    items.forEach((el) => el.classList.remove('opacity-0', 'translate-y-3'));
  } else if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.remove('opacity-0', 'translate-y-3');
            observer.unobserve(entry.target);
          }
        }
      },
      { rootMargin: '0px 0px -80px 0px' },
    );
    items.forEach((el) => observer.observe(el));
  } else {
    items.forEach((el) => el.classList.remove('opacity-0', 'translate-y-3'));
  }
  });
</script>
