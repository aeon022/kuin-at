---
// Header.astro — visual language from mockup.html, modernized per client
// request 2026-09 for a more accessible header: the mockup only ever
// showed 3 nav links, and only on desktop (≥md) — on mobile there was no
// way to navigate the site at all except the ⌘K search, which isn't
// discoverable for most users. Now: all real top-level routes, with a
// real mobile menu (native <button aria-expanded>, no dependency) and
// aria-current="page" so keyboard/screen-reader users know where they are
// — mockup had neither. Logo: the real KUIN wordmark (client request
// 2026-09), not a generated text mark — replaces the mockup's CSS "KUIN."
// text logo. "Über uns" has a real dropdown submenu (Vorstand/Team) —
// native CSS group-hover/group-focus-within, no JS/library — replacing an
// earlier version that just dumped two buttons into the page content
// (client feedback: that's not a submenu). Mobile nav nests the same two
// links under "Über uns" instead of a second disclosure mechanism.
import { getMediaItem } from 'orbiter:media';
const logo = await getMediaItem('05702c2b-c0ca-47d7-aef4-72e285f169cb');

interface Props { active?: string }
const { active } = Astro.props;
const links: { href: string; label: string; id: string; children?: { href: string; label: string }[] }[] = [
  { href: '/', label: 'Start', id: 'home' },
  { href: '/aktuell', label: 'Aktuell', id: 'events' },
  { href: '/archiv', label: 'Archiv', id: 'archiv' },
  { href: '/partner', label: 'Partner', id: 'partner' },
  {
    href: '/der-verein', label: 'Über uns', id: 'ueber-uns',
    children: [
      { href: '/der-verein/vorstand', label: 'Vorstand' },
      { href: '/der-verein/team', label: 'Team' },
    ],
  },
  { href: '/kontakt', label: 'Kontakt', id: 'kontakt' },
];
---
<header class="breathing-element sticky top-0 z-40 mx-auto flex w-full max-w-6xl items-center justify-between border-b border-sumi-400/10 bg-washi/90 px-6 py-6 backdrop-blur-md md:px-12 md:py-8">
  <a href="/" aria-label="Startseite" class="shrink-0 transition-opacity hover:opacity-80">
    {logo && <img src={logo.url} alt="KUIN — Kultur Inklusiv" class="h-9 w-auto md:h-10" />}
  </a>

  <div class="flex items-center gap-3 md:gap-8">
    <nav aria-label="Hauptnavigation" class="hidden gap-8 font-medium text-sumi-600 md:flex">
      {links.map((link) => (
        link.children ? (
          <div class="group relative">
            <a
              href={link.href}
              aria-current={active === link.id ? 'page' : undefined}
              aria-haspopup="true"
              class="flex items-center gap-1 rounded-full px-3 py-1.5 transition-colors hover:bg-kuin-magenta/10 hover:text-kuin-magenta aria-[current=page]:bg-kuin-magenta/10 aria-[current=page]:font-semibold aria-[current=page]:text-kuin-dark"
            >
              {link.label}
              <svg class="h-3 w-3 text-sumi-400 transition-transform group-hover:rotate-180 group-focus-within:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </a>
            <ul class="invisible absolute top-full left-0 z-10 mt-2 min-w-[10rem] rounded-2xl border border-sumi-400/10 bg-white p-2 opacity-0 shadow-lg transition-all duration-200 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
              {link.children.map((child) => (
                <li>
                  <a href={child.href} class="block rounded-xl px-4 py-2 text-sm font-medium text-sumi-900 transition-colors hover:bg-kuin-magenta/10 hover:text-kuin-magenta">
                    {child.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ) : (
          <a
            href={link.href}
            aria-current={active === link.id ? 'page' : undefined}
            class="rounded-full px-3 py-1.5 transition-colors hover:bg-kuin-magenta/10 hover:text-kuin-magenta aria-[current=page]:bg-kuin-magenta/10 aria-[current=page]:font-semibold aria-[current=page]:text-kuin-dark"
          >
            {link.label}
          </a>
        )
      ))}
    </nav>

    <div class="hidden h-6 w-px bg-sumi-400/30 md:block"></div>

    <!-- Leicht Lesen Toggle -->
    <button id="ll-toggle" aria-pressed="false" class="group flex items-center gap-3 rounded-full border border-sumi-400/10 bg-white px-4 py-2 shadow-sm transition-all duration-300 hover:border-kuin-magenta/30 hover:shadow-md">
      <span id="ll-track" class="relative inline-flex h-6 w-11 shrink-0 items-center rounded-full bg-sumi-400/25 transition-colors duration-300">
        <span id="ll-thumb" class="inline-block h-5 w-5 translate-x-0.5 transform rounded-full bg-white shadow transition-transform duration-300"></span>
      </span>
      <span class="hidden text-sm font-medium text-sumi-900 transition-colors group-hover:text-kuin-magenta sm:inline">Leicht Lesen</span>
    </button>

    <!-- Kuroko Trigger -->
    <button id="cmd-trigger" aria-label="Menü und Suche" class="flex h-10 w-10 items-center justify-center rounded-full bg-sumi-400/10 text-sumi-600 transition-colors duration-300 hover:bg-kuin-magenta hover:text-white">
      <svg class="h-4 w-4 md:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
      <span class="hidden text-sm font-medium md:block">⌘K</span>
    </button>

    <!-- Mobile menu toggle -->
    <button id="nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Hauptmenü öffnen" class="flex h-10 w-10 items-center justify-center rounded-full bg-sumi-400/10 text-sumi-600 transition-colors duration-300 hover:bg-kuin-magenta hover:text-white md:hidden">
      <svg id="nav-toggle-icon-open" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
      <svg id="nav-toggle-icon-close" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
    </button>
  </div>
</header>

<nav id="mobile-nav" aria-label="Hauptnavigation (mobil)" hidden class="border-b border-sumi-400/10 bg-washi px-6 py-4 md:hidden">
  <ul class="flex flex-col gap-1">
    {links.map((link) => (
      <li>
        <a
          href={link.href}
          aria-current={active === link.id ? 'page' : undefined}
          class="block rounded-xl px-3 py-2.5 font-medium text-sumi-900 transition-colors hover:bg-kuin-magenta/10 hover:text-kuin-magenta aria-[current=page]:bg-kuin-magenta/10 aria-[current=page]:text-kuin-dark"
        >
          {link.label}
        </a>
        {link.children && (
          <ul class="mt-1 ml-3 flex flex-col gap-1 border-l border-sumi-400/20 pl-3">
            {link.children.map((child) => (
              <li>
                <a href={child.href} class="block rounded-xl px-3 py-2 text-sm text-sumi-600 transition-colors hover:bg-kuin-magenta/10 hover:text-kuin-magenta">
                  {child.label}
                </a>
              </li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ul>
</nav>

<script>
  import { leichtLesen } from '../store/leichtLesen';

  const llToggle = document.getElementById('ll-toggle') as HTMLButtonElement;
  const llTrack = document.getElementById('ll-track') as HTMLSpanElement;
  const llThumb = document.getElementById('ll-thumb') as HTMLSpanElement;
  const root = document.documentElement;

  function render(active: boolean) {
    document.body.classList.toggle('is-leicht-lesen', active);
    llToggle.setAttribute('aria-pressed', String(active));
    llToggle.classList.toggle('border-kuin-magenta/30', active);
    llToggle.classList.toggle('bg-kuin-soft', active);
    llTrack.classList.toggle('bg-kuin-magenta', active);
    llTrack.classList.toggle('bg-sumi-400/25', !active);
    llThumb.classList.toggle('translate-x-[22px]', active);
    llThumb.classList.toggle('translate-x-0.5', !active);
    // Other routes render their Standard/Leicht-Lesen content server-side
    // from this attribute + cookie — kept in sync so the toggle still
    // works after navigating away from "/".
    root.toggleAttribute('data-ll', active);
    document.cookie = `kuin-leicht-lesen=${active}; path=/; max-age=31536000; samesite=lax`;
  }

  // Store starts at `false`, but hydrate it from the server-rendered
  // attribute (set from the cookie) so reloading an already-active
  // Leicht-Lesen session doesn't flash back to Standard.
  leichtLesen.set(root.hasAttribute('data-ll'));
  render(leichtLesen.get());
  // Plain nanostores atoms only expose `.listen()` (fires on change only,
  // not immediately) — there is no `.subscribe()` method on a bare atom
  // (that only exists on wrapped stores like @nanostores/persistent). The
  // initial render above already covers the "immediate" half.
  leichtLesen.listen(render);

  llToggle.addEventListener('click', () => {
    leichtLesen.set(!leichtLesen.get());
  });

  // Mobile nav disclosure — plain <button aria-expanded> + hidden attribute,
  // no dependency. Closes on Escape or on selecting a link.
  const navToggle = document.getElementById('nav-toggle') as HTMLButtonElement;
  const mobileNav = document.getElementById('mobile-nav') as HTMLElement;
  const iconOpen = document.getElementById('nav-toggle-icon-open') as HTMLElement;
  const iconClose = document.getElementById('nav-toggle-icon-close') as HTMLElement;

  function setNavOpen(open: boolean) {
    navToggle.setAttribute('aria-expanded', String(open));
    mobileNav.hidden = !open;
    iconOpen.classList.toggle('hidden', open);
    iconClose.classList.toggle('hidden', !open);
  }

  navToggle.addEventListener('click', () => setNavOpen(mobileNav.hidden));
  mobileNav.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).tagName === 'A') setNavOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !mobileNav.hidden) setNavOpen(false);
  });
</script>
