---
// Header.astro — visual language from mockup.html, modernized per client
// request 2026-09 for a more accessible header: the mockup only ever
// showed 3 nav links, and only on desktop (≥md) — on mobile there was no
// way to navigate the site at all except the ⌘K search, which isn't
// discoverable for most users. Now: all real top-level routes, with a
// real mobile menu (native <button aria-expanded>, no dependency) and
// aria-current="page" so keyboard/screen-reader users know where they are
// — mockup had neither. Logo: the real KUIN wordmark (client request
// 2026-09), not a generated text mark — replaces the mockup's CSS "KUIN."
// text logo. "Über uns" has a real dropdown submenu (Vorstand/Team) —
// native CSS group-hover/group-focus-within, no JS/library — replacing an
// earlier version that just dumped two buttons into the page content
// (client feedback: that's not a submenu). Mobile nav nests the same two
// links under "Über uns" instead of a second disclosure mechanism.
import { getMediaItem } from 'orbiter:media';
const logo = await getMediaItem('05702c2b-c0ca-47d7-aef4-72e285f169cb');

interface Props { active?: string }
const { active } = Astro.props;
const links: { href: string; label: string; id: string; children?: { href: string; label: string }[] }[] = [
  { href: '/', label: 'Start', id: 'home' },
  { href: '/aktuell', label: 'Aktuell', id: 'events' },
  { href: '/archiv', label: 'Archiv', id: 'archiv' },
  { href: '/partner', label: 'Mitglieder', id: 'partner' },
  {
    href: '/der-verein', label: 'Über uns', id: 'ueber-uns',
    children: [
      { href: '/der-verein/vorstand', label: 'Vorstand' },
      { href: '/der-verein/team', label: 'Team' },
    ],
  },
  { href: '/kontakt', label: 'Kontakt', id: 'kontakt' },
];
---
<header transition:persist class="breathing-element sticky top-0 z-40 mx-auto flex w-full max-w-7xl items-center justify-between border-b border-sumi-400/10 bg-washi/90 px-6 py-6 backdrop-blur-md md:px-12 md:py-8">
  <a href="/" aria-label="Startseite" class="shrink-0 transition-opacity hover:opacity-80">
    {logo && <img src={logo.url} alt="KUIN — Kultur Inklusiv" class="kuin-logo h-9 w-auto md:h-10" />}
  </a>

  <div class="flex items-center gap-3 lg:gap-4">
    <nav id="main-nav" aria-label="Hauptnavigation" class="relative hidden gap-1 font-medium text-sumi-600 md:flex">
      <span id="nav-indicator" class="pointer-events-none absolute top-0 left-0 -z-10 h-full rounded-full bg-kuin-magenta/10 opacity-0 transition-[transform,width,opacity] duration-300 ease-out"></span>
      {links.map((link) => (
        link.children ? (
          <div class="group relative">
            <a
              href={link.href}
              aria-current={active === link.id ? 'page' : undefined}
              aria-haspopup="true"
              class="flex items-center gap-1 rounded-full px-3 py-1.5 transition-colors hover:text-kuin-magenta aria-[current=page]:font-semibold aria-[current=page]:text-kuin-dark"
            >
              {link.label}
              <svg class="h-3 w-3 text-sumi-400 transition-transform group-hover:rotate-180 group-focus-within:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </a>
            <ul class="invisible absolute top-full left-0 z-10 mt-2 min-w-[10rem] rounded-2xl border border-sumi-400/10 bg-surface p-2 opacity-0 shadow-lg transition-all duration-200 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
              {link.children.map((child) => (
                <li>
                  <a href={child.href} class="block rounded-xl px-4 py-2 text-sm font-medium text-sumi-900 transition-colors hover:bg-kuin-magenta/10 hover:text-kuin-magenta">
                    {child.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ) : (
          <a
            href={link.href}
            aria-current={active === link.id ? 'page' : undefined}
            class="rounded-full px-3 py-1.5 transition-colors hover:text-kuin-magenta aria-[current=page]:font-semibold aria-[current=page]:text-kuin-dark"
          >
            {link.label}
          </a>
        )
      ))}
    </nav>

    <div class="hidden h-6 w-px bg-sumi-400/30 md:block"></div>

    <!-- Trigger cluster: Leicht-Lesen switch, search, mobile menu — one
         shared pill with dividers instead of three separate floating
         circles, so it reads as one toolbar. -->
    <div class="flex items-center rounded-full border border-sumi-400/10 bg-surface shadow-sm transition-shadow duration-300 hover:shadow-md">
      <!-- Leicht Lesen Toggle -->
      <button id="ll-toggle" aria-pressed="false" class="group flex h-10 items-center gap-2.5 rounded-full px-3.5 transition-colors duration-300 sm:px-4">
        <span id="ll-track" class="relative inline-flex h-6 w-11 shrink-0 items-center rounded-full bg-sumi-400/25 transition-colors duration-300">
          <span id="ll-thumb" class="inline-block h-5 w-5 translate-x-0.5 transform rounded-full bg-white shadow transition-transform duration-300"></span>
        </span>
        <span class="hidden text-sm font-medium text-sumi-900 transition-colors group-hover:text-kuin-magenta xl:inline">Leicht Lesen</span>
      </button>

      <div class="h-6 w-px bg-sumi-400/15"></div>

      <!-- Barrierefreiheits-Panel trigger -->
      <div class="relative">
        <button id="a11y-trigger" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="a11y-panel" aria-label="Barrierefreiheits-Optionen" class="flex h-10 items-center rounded-full px-3.5 text-sumi-600 transition-colors duration-300 hover:text-kuin-magenta sm:px-4">
          <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="4.5" r="1.6" fill="currentColor" stroke="none" />
            <path d="M11.2 6v5l3.3 2.2M11.2 11H7M13.6 12.5l2.2 6.5M9.5 22a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" />
          </svg>
        </button>
        <div id="a11y-panel" hidden class="absolute top-full right-0 z-20 mt-3 w-72 rounded-2xl border border-sumi-400/10 bg-surface p-5 shadow-xl">
          <p class="mb-3 text-xs font-bold tracking-widest text-sumi-400 uppercase">Barrierefreiheit</p>

          <div class="mb-4">
            <p class="mb-2 text-sm font-medium text-sumi-900">Textgröße</p>
            <div class="flex gap-2" role="group" aria-label="Textgröße wählen">
              <button type="button" data-font-size-btn="0" class="a11y-size-btn flex-1 rounded-xl border border-sumi-400/20 py-2 text-sm font-semibold text-sumi-600 transition-colors hover:border-kuin-magenta/40">A</button>
              <button type="button" data-font-size-btn="1" class="a11y-size-btn flex-1 rounded-xl border border-sumi-400/20 py-2 text-base font-semibold text-sumi-600 transition-colors hover:border-kuin-magenta/40">A</button>
              <button type="button" data-font-size-btn="2" class="a11y-size-btn flex-1 rounded-xl border border-sumi-400/20 py-2 text-lg font-semibold text-sumi-600 transition-colors hover:border-kuin-magenta/40">A</button>
            </div>
          </div>

          <div class="mb-4">
            <p class="mb-2 text-sm font-medium text-sumi-900">Darstellung</p>
            <div id="a11y-theme-group" class="flex gap-2" role="group" aria-label="Farbschema wählen">
              <button type="button" data-theme-btn="system" class="theme-btn flex-1 rounded-xl border border-sumi-400/20 py-2 text-sm font-semibold text-sumi-600 transition-colors hover:border-kuin-magenta/40" aria-label="System">
                <svg class="mx-auto h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2" /><path d="M8 21h8M12 17v4" /></svg>
              </button>
              <button type="button" data-theme-btn="light" class="theme-btn flex-1 rounded-xl border border-sumi-400/20 py-2 text-sm font-semibold text-sumi-600 transition-colors hover:border-kuin-magenta/40" aria-label="Hell">
                <svg class="mx-auto h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" /></svg>
              </button>
              <button type="button" data-theme-btn="dark" class="theme-btn flex-1 rounded-xl border border-sumi-400/20 py-2 text-sm font-semibold text-sumi-600 transition-colors hover:border-kuin-magenta/40" aria-label="Dunkel">
                <svg class="mx-auto h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" /></svg>
              </button>
            </div>
          </div>

          <div class="mb-4 flex items-center justify-between gap-4">
            <span class="text-sm font-medium text-sumi-900">Hoher Kontrast</span>
            <button id="contrast-toggle" type="button" role="switch" aria-checked="false" class="relative inline-flex h-6 w-11 shrink-0 items-center rounded-full bg-sumi-400/25 transition-colors duration-300">
              <span id="contrast-thumb" class="inline-block h-5 w-5 translate-x-0.5 transform rounded-full bg-white shadow transition-transform duration-300"></span>
            </button>
          </div>

          <div class="mb-4 flex items-center justify-between gap-4">
            <span class="text-sm font-medium text-sumi-900">Bewegung reduzieren</span>
            <button id="motion-toggle" type="button" role="switch" aria-checked="false" class="relative inline-flex h-6 w-11 shrink-0 items-center rounded-full bg-sumi-400/25 transition-colors duration-300">
              <span id="motion-thumb" class="inline-block h-5 w-5 translate-x-0.5 transform rounded-full bg-white shadow transition-transform duration-300"></span>
            </button>
          </div>

          <!-- Placeholder target (no dedicated statement page exists yet)
               — same /kontakt link Footer.astro's own "Barrierefreiheit"
               item already uses, so this isn't a second, different guess
               at where that content should live. -->
          <a href="/kontakt" class="block border-t border-sumi-400/10 pt-3 text-sm font-medium text-magenta-dark underline transition-colors hover:text-kuin-magenta">
            Erklärung zur Barrierefreiheit
          </a>
        </div>
      </div>

      <div class="h-6 w-px bg-sumi-400/15"></div>

      <!-- Kuroko Trigger -->
      <button id="cmd-trigger" aria-label="Menü und Suche" class="group flex h-10 items-center gap-2 rounded-full px-3.5 text-sumi-600 transition-colors duration-300 hover:text-kuin-magenta sm:px-4">
        <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
        <span class="hidden text-sm font-medium text-sumi-400 transition-colors group-hover:text-kuin-magenta md:inline">Suchen</span>
        <kbd class="hidden rounded-md border border-sumi-400/20 bg-sumi-400/5 px-1.5 py-0.5 font-sans text-xs font-semibold text-sumi-400 md:inline">/</kbd>
      </button>

      <div class="hidden h-6 w-px bg-sumi-400/15 lg:block"></div>

      <!-- Social — desktop-only here (toolbar's already tight on mobile);
           the same two links also live in #mobile-nav below for phones. -->
      <a href="https://www.instagram.com/kulturinklusiv/" target="_blank" rel="noopener noreferrer" aria-label="KUIN auf Instagram" class="hidden h-10 items-center rounded-full px-2.5 text-sumi-600 transition-colors duration-300 hover:text-kuin-magenta lg:flex">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none" /></svg>
      </a>
      <a href="https://www.facebook.com/profile.php?id=61593917724559" target="_blank" rel="noopener noreferrer" aria-label="KUIN auf Facebook" class="hidden h-10 items-center rounded-full px-2.5 text-sumi-600 transition-colors duration-300 hover:text-kuin-magenta lg:flex">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12a10 10 0 10-11.5 9.9v-7H8v-2.9h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.4h-1.2c-1.2 0-1.6.8-1.6 1.6v1.9H16l-.4 2.9h-2.1v7A10 10 0 0022 12z" /></svg>
      </a>

      <div class="h-6 w-px bg-sumi-400/15 md:hidden"></div>

      <!-- Mobile menu toggle -->
      <button id="nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Hauptmenü öffnen" class="flex h-10 w-10 items-center justify-center rounded-full text-sumi-600 transition-colors duration-300 hover:text-kuin-magenta md:hidden">
        <svg id="nav-toggle-icon-open" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
        <svg id="nav-toggle-icon-close" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>
  </div>
</header>

<nav id="mobile-nav" transition:persist aria-label="Hauptnavigation (mobil)" hidden class="border-b border-sumi-400/10 bg-washi px-6 py-4 md:hidden">
  <ul class="flex flex-col gap-1">
    {links.map((link) => (
      <li>
        <a
          href={link.href}
          aria-current={active === link.id ? 'page' : undefined}
          class="block rounded-xl px-3 py-2.5 font-medium text-sumi-900 transition-colors hover:bg-kuin-magenta/10 hover:text-kuin-magenta aria-[current=page]:bg-kuin-magenta/10 aria-[current=page]:text-kuin-dark"
        >
          {link.label}
        </a>
        {link.children && (
          <ul class="mt-1 ml-3 flex flex-col gap-1 border-l border-sumi-400/20 pl-3">
            {link.children.map((child) => (
              <li>
                <a href={child.href} class="block rounded-xl px-3 py-2 text-sm text-sumi-600 transition-colors hover:bg-kuin-magenta/10 hover:text-kuin-magenta">
                  {child.label}
                </a>
              </li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ul>
  <div class="mt-4 flex gap-2 border-t border-sumi-400/10 pt-4">
    <a href="https://www.instagram.com/kulturinklusiv/" target="_blank" rel="noopener noreferrer" aria-label="KUIN auf Instagram" class="flex h-10 w-10 items-center justify-center rounded-full text-sumi-600 transition-colors hover:bg-kuin-magenta/10 hover:text-kuin-magenta">
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none" /></svg>
    </a>
    <a href="https://www.facebook.com/profile.php?id=61593917724559" target="_blank" rel="noopener noreferrer" aria-label="KUIN auf Facebook" class="flex h-10 w-10 items-center justify-center rounded-full text-sumi-600 transition-colors hover:bg-kuin-magenta/10 hover:text-kuin-magenta">
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12a10 10 0 10-11.5 9.9v-7H8v-2.9h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.4h-1.2c-1.2 0-1.6.8-1.6 1.6v1.9H16l-.4 2.9h-2.1v7A10 10 0 0022 12z" /></svg>
    </a>
  </div>
</nav>

<script>
  import { leichtLesen } from '../store/leichtLesen';
  import { fontSize, highContrast, reduceMotion, type FontSizeStep } from '../store/accessibility';
  import { theme, type Theme } from '../store/theme';

  const llToggle = document.getElementById('ll-toggle') as HTMLButtonElement;
  const llTrack = document.getElementById('ll-track') as HTMLSpanElement;
  const llThumb = document.getElementById('ll-thumb') as HTMLSpanElement;
  const root = document.documentElement;

  function render(active: boolean) {
    document.body.classList.toggle('is-leicht-lesen', active);
    llToggle.setAttribute('aria-pressed', String(active));
    llToggle.classList.toggle('border-kuin-magenta/30', active);
    llToggle.classList.toggle('bg-kuin-soft', active);
    llTrack.classList.toggle('bg-kuin-magenta', active);
    llTrack.classList.toggle('bg-sumi-400/25', !active);
    llThumb.classList.toggle('translate-x-[22px]', active);
    llThumb.classList.toggle('translate-x-0.5', !active);
    // Other routes render their Standard/Leicht-Lesen content server-side
    // from this attribute + cookie — kept in sync so the toggle still
    // works after navigating away from "/".
    root.toggleAttribute('data-ll', active);
    document.cookie = `kuin-leicht-lesen=${active}; path=/; max-age=31536000; samesite=lax`;
  }

  // Store starts at `false`, but hydrate it from the server-rendered
  // attribute (set from the cookie) so reloading an already-active
  // Leicht-Lesen session doesn't flash back to Standard.
  leichtLesen.set(root.hasAttribute('data-ll'));
  render(leichtLesen.get());
  // Plain nanostores atoms only expose `.listen()` (fires on change only,
  // not immediately) — there is no `.subscribe()` method on a bare atom
  // (that only exists on wrapped stores like @nanostores/persistent). The
  // initial render above already covers the "immediate" half.
  leichtLesen.listen(render);

  llToggle.addEventListener('click', () => {
    leichtLesen.set(!leichtLesen.get());
  });

  // Mobile nav disclosure — plain <button aria-expanded> + hidden attribute,
  // no dependency. Closes on Escape or on selecting a link.
  const navToggle = document.getElementById('nav-toggle') as HTMLButtonElement;
  const mobileNav = document.getElementById('mobile-nav') as HTMLElement;
  const iconOpen = document.getElementById('nav-toggle-icon-open') as HTMLElement;
  const iconClose = document.getElementById('nav-toggle-icon-close') as HTMLElement;

  function setNavOpen(open: boolean) {
    navToggle.setAttribute('aria-expanded', String(open));
    mobileNav.hidden = !open;
    iconOpen.classList.toggle('hidden', open);
    iconClose.classList.toggle('hidden', !open);
  }

  navToggle.addEventListener('click', () => setNavOpen(mobileNav.hidden));
  mobileNav.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).tagName === 'A') setNavOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !mobileNav.hidden) setNavOpen(false);
  });

  // Sliding nav indicator — one pill that moves to whichever top-level
  // link is hovered/focused, falling back to the current page's link on
  // mouseleave. Positioned via measured pixel rects (getBoundingClientRect)
  // rather than CSS, since "which link" changes at runtime; `transform`
  // for the X move (compositor-friendly) plus a `width` transition for
  // the resize between differently-sized labels.
  const mainNav = document.getElementById('main-nav') as HTMLElement | null;
  const indicator = document.getElementById('nav-indicator') as HTMLElement | null;

  if (mainNav && indicator) {
    // Only direct children (top-level link, or the "Über uns" dropdown's
    // own trigger link) — not the dropdown's nested Vorstand/Team links.
    const topLevelLinks = Array.from(mainNav.querySelectorAll(':scope > a, :scope > div > a')) as HTMLAnchorElement[];

    function moveIndicatorTo(el: HTMLElement) {
      if (!mainNav || !indicator) return;
      const navRect = mainNav.getBoundingClientRect();
      const elRect = el.getBoundingClientRect();
      indicator.style.width = `${elRect.width}px`;
      indicator.style.transform = `translateX(${elRect.left - navRect.left}px)`;
      indicator.style.opacity = '1';
    }

    function resetIndicator() {
      const activeLink = mainNav?.querySelector('a[aria-current="page"]') as HTMLElement | null;
      if (activeLink) moveIndicatorTo(activeLink);
      else if (indicator) indicator.style.opacity = '0';
    }

    topLevelLinks.forEach((link) => {
      link.addEventListener('mouseenter', () => moveIndicatorTo(link));
      link.addEventListener('focus', () => moveIndicatorTo(link));
    });
    mainNav.addEventListener('mouseleave', resetIndicator);
    window.addEventListener('resize', resetIndicator);

    resetIndicator();

    // Page-transition support: <header> and #mobile-nav are both
    // `transition:persist`ed (this whole script only ever runs once,
    // on true first load), so they stop getting a fresh server-rendered
    // aria-current from each new page's own `active` prop the way they
    // did before View Transitions existed — has to be recomputed
    // client-side on every navigation instead. Matches by longest
    // prefix against each top-level link's own `.pathname` (not the
    // `links` array from frontmatter — that's server-only, not
    // available in this client script) so a nested route like
    // /der-verein/vorstand still highlights "Über uns", same as the
    // server-computed version did.
    function syncActiveNav() {
      const path = window.location.pathname;
      const allTopLevel: HTMLAnchorElement[] = [
        ...topLevelLinks,
        ...(mobileNav ? (Array.from(mobileNav.querySelectorAll(':scope > ul > li > a')) as HTMLAnchorElement[]) : []),
      ];
      let best: HTMLAnchorElement | null = null;
      for (const link of allTopLevel) {
        const href = link.pathname;
        const matches = href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
        if (matches && (!best || href.length > best.pathname.length)) best = link;
      }
      allTopLevel.forEach((link) => link.removeAttribute('aria-current'));
      if (best) {
        const bestHref = best.pathname;
        allTopLevel.filter((l) => l.pathname === bestHref).forEach((l) => l.setAttribute('aria-current', 'page'));
      }
      resetIndicator();
    }
    document.addEventListener('astro:page-load', syncActiveNav);
  }

  // Barrierefreiheits-Panel — same hydrate-from-server-attribute pattern
  // as Leicht Lesen above, times three (font size, contrast, motion).
  const a11yTrigger = document.getElementById('a11y-trigger') as HTMLButtonElement;
  const a11yPanel = document.getElementById('a11y-panel') as HTMLElement;
  const sizeButtons = Array.from(document.querySelectorAll('[data-font-size-btn]')) as HTMLButtonElement[];
  const contrastToggle = document.getElementById('contrast-toggle') as HTMLButtonElement;
  const contrastThumb = document.getElementById('contrast-thumb') as HTMLSpanElement;
  const motionToggle = document.getElementById('motion-toggle') as HTMLButtonElement;
  const motionThumb = document.getElementById('motion-thumb') as HTMLSpanElement;

  function setA11yPanelOpen(open: boolean) {
    a11yTrigger.setAttribute('aria-expanded', String(open));
    a11yPanel.hidden = !open;
  }

  a11yTrigger.addEventListener('click', () => setA11yPanelOpen(a11yPanel.hidden));
  document.addEventListener('click', (e) => {
    if (!a11yPanel.hidden && !a11yPanel.contains(e.target as Node) && e.target !== a11yTrigger && !a11yTrigger.contains(e.target as Node)) {
      setA11yPanelOpen(false);
    }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !a11yPanel.hidden) {
      setA11yPanelOpen(false);
      a11yTrigger.focus();
    }
  });

  function renderFontSize(step: FontSizeStep) {
    root.toggleAttribute('data-font-size', step !== '0');
    if (step === '0') root.removeAttribute('data-font-size');
    else root.setAttribute('data-font-size', step);
    sizeButtons.forEach((btn) => {
      const isActive = btn.dataset.fontSizeBtn === step;
      btn.classList.toggle('border-kuin-magenta', isActive);
      btn.classList.toggle('bg-kuin-magenta/10', isActive);
      btn.classList.toggle('text-kuin-dark', isActive);
    });
    document.cookie = `kuin-font-size=${step}; path=/; max-age=31536000; samesite=lax`;
  }
  fontSize.set((root.getAttribute('data-font-size') as FontSizeStep | null) ?? '0');
  renderFontSize(fontSize.get());
  fontSize.listen(renderFontSize);
  sizeButtons.forEach((btn) => {
    btn.addEventListener('click', () => fontSize.set(btn.dataset.fontSizeBtn as FontSizeStep));
  });

  function renderContrast(active: boolean) {
    root.toggleAttribute('data-contrast', active);
    contrastToggle.setAttribute('aria-checked', String(active));
    contrastToggle.classList.toggle('bg-kuin-magenta', active);
    contrastToggle.classList.toggle('bg-sumi-400/25', !active);
    contrastThumb.classList.toggle('translate-x-[22px]', active);
    contrastThumb.classList.toggle('translate-x-0.5', !active);
    document.cookie = `kuin-contrast=${active}; path=/; max-age=31536000; samesite=lax`;
  }
  highContrast.set(root.hasAttribute('data-contrast'));
  renderContrast(highContrast.get());
  highContrast.listen(renderContrast);
  contrastToggle.addEventListener('click', () => highContrast.set(!highContrast.get()));

  function renderReduceMotion(active: boolean) {
    root.toggleAttribute('data-reduce-motion', active);
    motionToggle.setAttribute('aria-checked', String(active));
    motionToggle.classList.toggle('bg-kuin-magenta', active);
    motionToggle.classList.toggle('bg-sumi-400/25', !active);
    motionThumb.classList.toggle('translate-x-[22px]', active);
    motionThumb.classList.toggle('translate-x-0.5', !active);
    document.cookie = `kuin-reduce-motion=${active}; path=/; max-age=31536000; samesite=lax`;
  }
  reduceMotion.set(root.hasAttribute('data-reduce-motion'));
  renderReduceMotion(reduceMotion.get());
  reduceMotion.listen(renderReduceMotion);
  motionToggle.addEventListener('click', () => reduceMotion.set(!reduceMotion.get()));

  // Darstellung (System/Hell/Dunkel) — same shared `theme` store as
  // Footer.astro's own copy of this control; scoped queries (this panel's
  // own container id) so each component only ever touches its own
  // buttons, not the other one's, even though both listen to the same
  // atom and both end up writing the same cookie/attribute on click.
  const themeButtons = Array.from(document.querySelectorAll('#a11y-theme-group [data-theme-btn]')) as HTMLButtonElement[];

  function renderTheme(t: Theme) {
    if (t === 'system') root.removeAttribute('data-theme');
    else root.setAttribute('data-theme', t);
    themeButtons.forEach((btn) => {
      const active = btn.dataset.themeBtn === t;
      btn.classList.toggle('border-kuin-magenta', active);
      btn.classList.toggle('bg-kuin-magenta/10', active);
      btn.classList.toggle('text-kuin-dark', active);
    });
    document.cookie = `kuin-theme=${t}; path=/; max-age=31536000; samesite=lax`;
  }
  theme.set((root.getAttribute('data-theme') as Theme | null) ?? 'system');
  renderTheme(theme.get());
  theme.listen(renderTheme);
  themeButtons.forEach((btn) => {
    btn.addEventListener('click', () => theme.set(btn.dataset.themeBtn as Theme));
  });
</script>
