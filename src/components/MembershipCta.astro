---
// MembershipCta.astro — new section (client draft, 2026-09), not part of
// the original mockup: "Werde Teil der Bewegung" + a real newsletter
// signup. Same show-on-ll/hide-on-ll crossfade mechanism as the rest of
// the homepage. The newsletter form posts to Orbiter's public form
// endpoint (submissions land in the admin Inbox) — see orbiterForm.ts.
import { getEntry } from 'orbiter:collections';
import { getMediaItem } from 'orbiter:media';

const membershipForm = await getEntry('downloads', 'beitrittsformular-mitgliedschaft-2025');
const membershipFile = membershipForm ? await getMediaItem(membershipForm.data.file as string) : null;
---
<section class="breathing-element border-t border-sumi-400/10 pt-24 text-center">
  <div class="relative-container mx-auto min-h-[220px] max-w-2xl md:min-h-[180px]">
    <!-- Standard -->
    <div class="hide-on-ll space-y-6">
      <h2 class="font-serif text-4xl font-bold text-sumi-900">Werde Teil des Netzwerks.</h2>
      <p class="text-lg leading-relaxed text-sumi-600">
        Werde Teil von KUIN – Kultur Inklusiv und unterstütze eine offene und barrierefreie Kulturlandschaft. Als Mitglied trägst du aktiv dazu bei, Kultur inklusiver zu gestalten, und profitierst von einem starken Netzwerk.
      </p>
    </div>
    <!-- Leicht Lesen -->
    <div class="show-on-ll font-ll rounded-2xl border-l-8 border-kuin-magenta bg-kuin-soft p-6 text-xl leading-[1.8] text-sumi-900 md:p-8">
      Mach bei uns mit! Werde Mitglied in unserem Verein.<br />
      Mit dir zusammen machen wir Kultur in Graz für alle offen.
    </div>
  </div>

  {membershipFile && (
    <a href={membershipFile.url} class="mt-8 inline-flex items-center gap-2 rounded-2xl bg-magenta-dark px-6 py-3 font-medium text-washi transition hover:-translate-y-1 hover:bg-kuin-magenta">
      Mitglied werden
    </a>
  )}

  <form
    data-form-id="newsletter"
    action={`${import.meta.env.PUBLIC_ORBITER_ADMIN_URL}/api/form/newsletter`}
    method="POST"
    class="mx-auto mt-10 flex max-w-md flex-col items-center gap-3 sm:flex-row"
  >
    <input type="text" name="_honeypot" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <label for="newsletter-email" class="sr-only">E-Mail für den Newsletter</label>
    <input
      id="newsletter-email"
      name="email"
      type="email"
      required
      placeholder="Deine E-Mail-Adresse"
      class="w-full rounded-2xl border border-sumi-900/15 bg-surface px-4 py-2.5 text-sumi-900 outline-none"
    />
    <button type="submit" class="shrink-0 rounded-2xl border border-sumi-900/15 px-6 py-2.5 font-medium text-sumi-900 transition hover:-translate-y-1 hover:bg-sumi-900/5">
      Newsletter abonnieren
    </button>
  </form>
  <p data-form-status hidden class="mt-3"></p>
</section>

<script>
  import { wireOrbiterForm } from '../lib/orbiterForm';
  const form = document.querySelector('form[data-form-id="newsletter"]');
  if (form instanceof HTMLFormElement) wireOrbiterForm(form);
</script>
